import { Theme, UISize, ButtonVariant, ButtonState, ControlSize, Images } from "@ui/theme.slint";
import { Screen, Callbacks, Ui, Home, Compose, ToRow, Confirm, ConfirmSign, ConfirmRow, Notes, NoteRow, View, Sync, SignPsbt, Settings, Contacts, ContactRow, Coins, CoinRow, Sweep, NotebooksUi, NotebookCb, NotebookRow, SenderRow, Recovery, ExportNbRow, Funding, FundingCoinRow, ChangePick, QuantumKeys, DeviceQuantumKey } from "callbacks.slint";
import { Button } from "@ui/button.slint";
import { PrimaryAction, SecondaryAction, ScreenHeader, PillOption, EditorField, NoteEntry, FundingCoinEntry, ChangeOptionRow, ContactEntry, ToRowEntry, ConfirmRowEntry } from "components.slint";
import { HomeScreen } from "screens/home.slint";
import { NotesScreen } from "screens/notes.slint";
import { NoteScreen } from "screens/note.slint";
import { ComposeScreen } from "screens/compose.slint";
import { ConfirmSignScreen } from "screens/confirm-sign.slint";
import { SyncScreen } from "screens/sync.slint";
import { SignedScreen } from "screens/signed.slint";
import { CoinsScreen } from "screens/coins.slint";
import { SweepScreen } from "screens/sweep.slint";
import { SettingsScreen } from "screens/settings.slint";
import { AccountsScreen } from "screens/accounts.slint";
import { RecoveryWordsScreen } from "screens/recovery-words.slint";
import { PublicKeysScreen } from "screens/public-keys.slint";
import { PrivateKeysScreen } from "screens/private-keys.slint";
import { PayFromScreen } from "screens/pay-from.slint";
import { ChangeScreen } from "screens/change.slint";
import { QuantumKeysScreen } from "screens/quantum-keys.slint";
import { DeviceQuantumKeyScreen } from "screens/device-quantum-key.slint";

export { Screen, Callbacks, Ui, Home, Compose, ToRow, Confirm, ConfirmSign, Notes, View, Sync, SignPsbt, Settings, Contacts, Coins, Sweep, NotebooksUi, NotebookCb, Recovery, Funding, ChangePick, QuantumKeys, DeviceQuantumKey, Theme, ButtonVariant, ButtonState, ControlSize, Images }


export component AppWindow inherits Window {
    title: "Graffito";
    preferred-width: 480px;
    preferred-height: 800px;
    background: Theme.palette-background;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.palette-background;

        // ------------------------------------------------ screen 0: home
        // A NOTEBOOK's home (its address, notes, compose). The header back
        // returns to the notebook list (screen 20 — the main screen).
        if Ui.screen == Screen.home: HomeScreen {
            width: parent.width;
            height: parent.height;
        }

        // ------------------------------------------- screen 1: notes list
        if Ui.screen == Screen.notes: NotesScreen {
            width: parent.width;
            height: parent.height;
        }

        // -------------------------------------------- screen 2: note view
        if Ui.screen == Screen.note: NoteScreen {
            width: parent.width;
            height: parent.height;
        }

        // ---------------------------------------------- screen 3: compose
        // Everything interactive stays in the top ~400px so the on-screen
        // keyboard never covers a control (sibling-app gotcha).
        if Ui.screen == Screen.compose: ComposeScreen {
            width: parent.width;
            height: parent.height;
        }

        // ----------------------------------- screen 4: universal Confirm & sign
        // Shared by compose/sweep/consolidate/external-PSBT: every fact shown
        // here is decoded from the actual (un)signed tx bytes by notes-core's
        // `confirm::summarize_signed_tx` — never from the app's own intent —
        // so it's the last line of defense before anything hits the wire.
        // The Flickable stretches so the Sign button stays pinned at the
        // screen's true bottom regardless of how many rows there are.
        if Ui.screen == Screen.confirm-sign: ConfirmSignScreen {
            width: parent.width;
            height: parent.height;
        }

        // ------------------------------------------------- screen 5: sync
        if Ui.screen == Screen.sync: SyncScreen {
            width: parent.width;
            height: parent.height;
        }

        // -------------------------------------------- screen 8: signed PSBT
        if Ui.screen == Screen.signed: SignedScreen {
            width: parent.width;
            height: parent.height;
        }

        // ------------------------------------ screen 9: coins (viewer-first)
        // The UTXO ledger as of the last sync bundle. ONE action — the
        // consolidate button on top — opens the shared sweep screen (10).
        if Ui.screen == Screen.coins: CoinsScreen {
            width: parent.width;
            height: parent.height;
        }

        // ---------------------- screen 10: sweep / consolidate (compose-like)
        // Shared flow: destination line (picker- or self-set), fee tiers with
        // the collapse-on-Custom rate field, read-only inputs summary, live
        // cost line. A sweep spends ALL coins by design — no coin picking.
        if Ui.screen == Screen.sweep: SweepScreen {
            width: parent.width;
            height: parent.height;
        }

        // -------------------------------------------- screen 6: settings
        if Ui.screen == Screen.settings: SettingsScreen {
            width: parent.width;
            height: parent.height;
        }

        // ----------------------------------------- screen 21: accounts
        // Wallet-context switcher only (rotation seed index + BIP-86
        // account). The words reveal lives on its own screen (22), reached
        // from a separate Settings entry.
        if Ui.screen == Screen.accounts: AccountsScreen {
            width: parent.width;
            height: parent.height;
        }

        // ---------------------------------- screen 22: recovery words
        // Dedicated reveal, reached straight from Settings. Words/SeedQR
        // for the active seed; Back → Settings, clearing them
        // (reveal-close). Fits comfortably on its own, no scrolling.
        if Ui.screen == Screen.recovery-words: RecoveryWordsScreen {
            width: parent.width;
            height: parent.height;
        }

        // ------------------------------------- screen 23: PUBLIC keys
        // Watch-only exports for the active account: xpub + tr() descriptor
        // (whole account, all addresses). Safe to share.
        if Ui.screen == Screen.public-keys: PublicKeysScreen {
            width: parent.width;
            height: parent.height;
        }

        // ------------------------------------- screen 24: PRIVATE keys
        // The dangerous exports: recovery words (whole seed) and a single
        // notebook's raw key (hex/WIF). Camera warning up top.
        if Ui.screen == Screen.private-keys: PrivateKeysScreen {
            width: parent.width;
            height: parent.height;
        }

        // ---------------------------------- screen 25: Pay from (funding)
        // Two expandable coin lists — notebook (taproot) and spending
        // wallet (P2WPKH) — with independent per-coin selection. Selecting
        // coins from both sources at once is allowed (signed in one pass
        // via wpkh::sign_mixed_inputs) and flagged with a linkage warning.
        if Ui.screen == Screen.pay-from: PayFromScreen {
            width: parent.width;
            height: parent.height;
        }

        // -------------------------------------------- screen 26: Change
        // Single-select destination for the compose in progress.
        if Ui.screen == Screen.change: ChangeScreen {
            width: parent.width;
            height: parent.height;
        }

        // --------------------------------- screen 27: Quantum keys (pq.rs)
        // This notebook's post-quantum (ML-KEM) receive identity: level
        // picker, fingerprint, and a scannable QR of the armored public
        // key for a contact to import. Public-key export only — the 24
        // recovery words (Settings → "Recovery words…") already
        // reconstruct every derived key, so no separate private-key
        // export lives here.
        if Ui.screen == Screen.quantum-keys: QuantumKeysScreen {
            width: parent.width;
            height: parent.height;
        }

        // Fullscreen armor-QR overlay (screen 27's tap-to-zoom) — a LATER
        // SIBLING of the screen layout so it paints on top; white ground
        // so the code has maximum contrast, QR at the largest square that
        // fits. Tap anywhere closes (dismiss TouchArea is the LAST child —
        // the qr-zoom rule: anything stacked above it swallows the tap).
        if Ui.screen == Screen.quantum-keys && QuantumKeys.qr-zoom: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #ffffff;
            Image {
                source: QuantumKeys.public-qr;
                width: min(parent.width, parent.height) - 24px;
                height: self.width;
                image-rendering: pixelated;
            }
            TouchArea {
                clicked => {
                    QuantumKeys.qr-zoom = false;
                    Callbacks.quantum-qr-zoom(false);
                }
            }
        }

        // -------------------------------- screen 28: my quantum key
        // PLAN-graffito-quantum-key.md: a single, NON-seed-derived
        // personal ML-KEM keypair — generate-or-import while none exists,
        // else fingerprint + share/export/replace/delete. `DeviceQuantumKey
        // .view` picks which panel of the "key present" state shows.
        if Ui.screen == Screen.device-quantum-key: DeviceQuantumKeyScreen {
            width: parent.width;
            height: parent.height;
        }

        // Fullscreen armor-QR overlay (screen 28's tap-to-zoom) — mirrors
        // screen 27's; picks the public or private QR by which panel is
        // showing.
        if Ui.screen == Screen.device-quantum-key && DeviceQuantumKey.qr-zoom: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #ffffff;
            Image {
                source: DeviceQuantumKey.view == "private" ? DeviceQuantumKey.private-qr : DeviceQuantumKey.public-qr;
                width: min(parent.width, parent.height) - 24px;
                height: self.width;
                image-rendering: pixelated;
            }
            TouchArea {
                clicked => {
                    DeviceQuantumKey.qr-zoom = false;
                    Callbacks.device-quantum-key-qr-zoom(false);
                }
            }
        }

        // ------------------------------------ screen 7: contacts (send-to)
        // The one input slot doubles as manual address entry and, when a
        // row's "name" zone was tapped, the contact-name editor. Errors go
        // in the label above the field so the keyboard can't hide them.
        if Ui.screen == Screen.contacts: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px + UISize.control-center-status-bar-height;
            padding-bottom: 24px;
            spacing: 10px;

            ScreenHeader {
                vertical-stretch: 0;
                title: Contacts.pick-mode == "sweep" ? "Sweep to" : "Send to";
                back => {
                    if Contacts.pick-mode == "sweep" {
                        Contacts.pick-mode = "compose";
                        Ui.screen = Screen.settings;
                    } else {
                        Callbacks.refresh-home();
                        Ui.screen = Screen.home;
                    }
                }
            }

            Text {
                vertical-stretch: 0;
                height: 18px;
                text: Contacts.input-error != "" ? Contacts.input-error
                    : Contacts.pick-mode == "sweep" ? "Destination address" : "Recipient address";
                color: Contacts.input-error != "" ? Theme.palette-danger : Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 14px;
                overflow: elide;
            }
            HorizontalLayout {
                vertical-stretch: 0;
                height: 44px;
                spacing: 8px;
                Rectangle {
                    height: 44px;
                    horizontal-stretch: 1;
                    background: Theme.palette-surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: contact-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                    clip: true;
                    contact-input := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        height: 24px;
                        y: (parent.height - self.height) / 2;
                        text <=> Contacts.input-text;
                        color: Theme.palette-foreground;
                        font-family: "SourceCodePro";
                        font-size: 15px;
                        single-line: true;
                        edited => { Contacts.input-error = ""; }
                        // Keyboard "Done" blurs → KeyOS hides the keyboard.
                        accepted => { self.clear-focus(); }
                    }
                    Text {
                        x: 14px;
                        height: parent.height;
                        text: Contacts.input-text == "" && contact-input.preedit-text == ""
                            ? "Paste or type an address…" : "";
                        color: Theme.palette-muted;
                        font-family: "SourceCodePro";
                        font-size: 15px;
                        vertical-alignment: center;
                    }
                }
                // Fixed width so the address field gets the room.
                PillOption {
                    width: 72px;
                    label: "Use";
                    selected: true;
                    tapped => { Callbacks.pick-contact(Contacts.input-text); }
                }
            }

            // First and handiest option: the classic self-notebook note.
            // Hidden in sweep mode — sweep-to-self is the Coins screen's
            // consolidate, not a picker choice.
            if Contacts.pick-mode != "sweep": Rectangle {
                vertical-stretch: 0;
                height: 56px;
                border-radius: 12px;
                background: self-touch.has-hover ? Theme.palette-surface : transparent;
                border-width: 1px;
                border-color: Theme.palette-primary;
                self-touch := TouchArea { clicked => { Callbacks.pick-contact(""); } }
                VerticalLayout {
                    padding: 10px;
                    spacing: 2px;
                    Text {
                        text: "To: Self";
                        color: Theme.palette-foreground;
                        font-family: "Montserrat";
                        font-size: 18px;
                        font-weight: 600;
                    }
                    Text {
                        text: "my notebook — this device's own address";
                        color: Theme.palette-muted;
                        font-family: "Montserrat";
                        font-size: 13px;
                    }
                }
            }

            SecondaryAction {
                vertical-stretch: 0;
                height: 52px;
                width: 100%;
                text: "Scan address QR";
                clicked => { Callbacks.scan-contact(); }
            }

            Text {
                vertical-stretch: 0;
                height: 16px;
                text: Contacts.rows.length > 0 ? "Recent"
                    : "Addresses you send to appear here.";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
            }

            Flickable {
                vertical-stretch: 1;
                viewport-height: Contacts.rows.length * 72px;
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    for entry in Contacts.rows: ContactEntry {
                        entry: entry;
                        tapped => { Callbacks.pick-contact(entry.address); }
                        rename => {
                            Contacts.naming-address = entry.address;
                            Contacts.name-text = entry.name;
                            Contacts.naming-label = "Name for " + entry.meta;
                            Contacts.naming-pq-caption = entry.pq-caption;
                            Contacts.naming-pq-error = "";
                        }
                    }
                }
            }
        }

        // Naming dialog — modal over the contacts screen. Anchored near
        // the TOP so the on-screen keyboard never covers it; nested inside
        // the root container (sibling-app gotcha).
        // ------------------------------------ screen 20: notebooks (MAIN)
        // A notebook = an indexed identity; tapping a row opens its home
        // (screen 0). Boot lands here. Fresh install = empty list.
        if Ui.screen == Screen.notebooks: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 24px + UISize.control-center-status-bar-height;
            padding-bottom: 24px;
            spacing: 14px;

            Text {
                text: "Graffito";
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 26px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            PrimaryAction {
                width: 100%;
                text: "+  New notebook";
                clicked => { NotebookCb.create(); }
            }
            SecondaryAction {
                width: 100%;
                text: "Settings";
                clicked => { Callbacks.refresh-home(); Callbacks.funding-open(); Ui.screen = Screen.settings; }
            }

            if Ui.error != "": Text {
                text: Ui.error;
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }

            if NotebooksUi.empty-line != "": Text {
                text: NotebooksUi.empty-line;
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 15px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }

            Flickable {
                vertical-stretch: 1;
                viewport-height: NotebooksUi.rows.length * 92px
                    + (NotebooksUi.archived-label != "" ? 44px : 0px)
                    + (NotebooksUi.show-archived ? NotebooksUi.archived-rows.length * 72px : 0px);
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    for nb in NotebooksUi.rows: Rectangle {
                        height: 84px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: nb.active ? Theme.palette-primary : Theme.palette-border;
                        TouchArea { clicked => { NotebookCb.open(nb.account); } }
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                alignment: center;
                                Text {
                                    text: nb.name;
                                    color: Theme.palette-foreground;
                                    font-family: "Montserrat";
                                    font-size: 18px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: nb.meta;
                                    color: Theme.palette-muted;
                                    font-family: "SourceCodePro";
                                    font-size: 13px;
                                    overflow: elide;
                                }
                            }
                            // Rename
                            Rectangle {
                                width: 40px;
                                TouchArea { clicked => { NotebookCb.rename(nb.account); } }
                                Text {
                                    text: "Aa";
                                    color: Theme.palette-muted;
                                    font-family: "Montserrat";
                                    font-size: 15px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            // Archive
                            Rectangle {
                                width: 40px;
                                TouchArea { clicked => { NotebookCb.archive(nb.account, true); } }
                                Text {
                                    text: "×";
                                    color: Theme.palette-muted;
                                    font-family: "Montserrat";
                                    font-size: 22px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                    if NotebooksUi.archived-label != "": Rectangle {
                        height: 36px;
                        TouchArea { clicked => { NotebooksUi.show-archived = !NotebooksUi.show-archived; } }
                        Text {
                            text: NotebooksUi.archived-label + (NotebooksUi.show-archived ? "  ^" : "  v");
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 14px;
                            x: 4px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    if NotebooksUi.show-archived: VerticalLayout {
                        spacing: 8px;
                        for nb in NotebooksUi.archived-rows: Rectangle {
                            height: 64px;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.palette-border;
                            HorizontalLayout {
                                padding: 12px;
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: nb.name;
                                        color: Theme.palette-muted;
                                        font-family: "Montserrat";
                                        font-size: 15px;
                                        overflow: elide;
                                    }
                                }
                                SecondaryAction {
                                    text: "Restore";
                                    clicked => { NotebookCb.archive(nb.account, false); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- notebook name dialog (create + rename) ----
        if NotebooksUi.name-account != -1: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000088;
            TouchArea { }   // swallow taps outside the panel
            Rectangle {
                x: 24px;
                y: 90px + UISize.control-center-status-bar-height;
                width: parent.width - 48px;
                height: 176px;
                background: Theme.palette-surface;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.palette-border;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        height: 20px;
                        text: NotebooksUi.name-account == -2 ? "Name your new notebook" : "Name this notebook";
                        color: Theme.palette-foreground;
                        font-family: "Montserrat";
                        font-size: 16px;
                        font-weight: 600;
                    }
                    Rectangle {
                        height: 44px;
                        background: Theme.palette-background;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: nb-name-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                        clip: true;
                        nb-name-input := TextInput {
                            x: 14px;
                            width: parent.width - 28px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            text <=> NotebooksUi.name-text;
                            color: Theme.palette-foreground;
                            font-family: "Montserrat";
                            font-size: 16px;
                            single-line: true;
                            accepted => { self.clear-focus(); }
                        }
                        Text {
                            x: 14px;
                            height: parent.height;
                            text: NotebooksUi.name-text == "" && nb-name-input.preedit-text == ""
                                ? "Name (optional)" : "";
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 15px;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        height: 48px;
                        spacing: 8px;
                        SecondaryAction {
                            horizontal-stretch: 1;
                            font-size: 16px;          // 48px row: default 20px+12px padding elides (2026-08-22)
                            padding-vertical: 6px;
                            text: "Cancel";
                            clicked => {
                                nb-name-input.clear-focus();
                                NotebookCb.name-cancel();
                            }
                        }
                        PrimaryAction {
                            horizontal-stretch: 1;
                            font-size: 16px;          // 48px row: default 20px+12px padding elides (2026-08-22)
                            padding-vertical: 6px;
                            text: NotebooksUi.name-account == -2 ? "Create" : "Save";
                            clicked => {
                                nb-name-input.clear-focus();
                                NotebookCb.name-save();
                            }
                        }
                    }
                }
            }
        }

        if Contacts.naming-address != "": Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000088;
            TouchArea { }   // swallow taps outside the panel
            Rectangle {
                x: 24px;
                y: 90px + UISize.control-center-status-bar-height;
                width: parent.width - 48px;
                height: 254px;
                background: Theme.palette-surface;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.palette-border;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        height: 20px;
                        text: Contacts.naming-label;
                        color: Theme.palette-foreground;
                        font-family: "Montserrat";
                        font-size: 16px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Rectangle {
                        height: 44px;
                        background: Theme.palette-background;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: name-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                        clip: true;
                        name-input := TextInput {
                            x: 14px;
                            width: parent.width - 28px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            text <=> Contacts.name-text;
                            color: Theme.palette-foreground;
                            font-family: "Montserrat";
                            font-size: 16px;
                            single-line: true;
                            // Keyboard "Done" blurs → keyboard hides.
                            accepted => { self.clear-focus(); }
                        }
                        Text {
                            x: 14px;
                            height: parent.height;
                            text: Contacts.name-text == "" && name-input.preedit-text == ""
                                ? "Contact name (empty to clear)" : "";
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 15px;
                            vertical-alignment: center;
                        }
                    }
                    // Quantum key (pq.rs): scan an armored ML-KEM public
                    // key for this contact — enables the ML-KEM layer on
                    // directed private notes addressed to them.
                    Text {
                        height: 16px;
                        text: Contacts.naming-pq-error != "" ? Contacts.naming-pq-error
                            : Contacts.naming-pq-caption != "" ? Contacts.naming-pq-caption
                            : "No quantum key on file";
                        color: Contacts.naming-pq-error != "" ? Theme.palette-danger : Theme.palette-muted;
                        font-family: "SourceCodePro";
                        font-size: 12px;
                        overflow: elide;
                    }
                    SecondaryAction {
                        height: 40px;
                        width: 100%;
                        // 40px tall: the component's 20px font + 12px
                        // vertical padding elide the label to NOTHING —
                        // shrink both (the pre-pq naming dialog had the
                        // same blank-button bug; 2026-08-22).
                        font-size: 15px;
                        padding-vertical: 6px;
                        text: "Scan quantum key";
                        clicked => { Callbacks.scan-contact-pq(); }
                    }
                    HorizontalLayout {
                        height: 48px;
                        spacing: 8px;
                        SecondaryAction {
                            horizontal-stretch: 1;
                            font-size: 16px;          // 48px row: default 20px+12px padding elides (2026-08-22)
                            padding-vertical: 6px;
                            text: "Cancel";
                            clicked => {
                                Contacts.naming-address = "";
                                Contacts.name-text = "";
                                Contacts.naming-pq-caption = "";
                                Contacts.naming-pq-error = "";
                            }
                        }
                        PrimaryAction {
                            horizontal-stretch: 1;
                            font-size: 16px;
                            padding-vertical: 6px;
                            text: "Save";
                            clicked => {
                                name-input.clear-focus();
                                Callbacks.save-contact-name();
                            }
                        }
                    }
                }
            }
        }

        // Note-too-large dialog — nested in root (sibling-app overlay gotcha).
        if Compose.show-oversize: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000088;
            TouchArea { }   // swallow taps outside the panel
            Rectangle {
                x: 24px;
                y: 90px + UISize.control-center-status-bar-height;
                width: parent.width - 48px;
                height: oversize-panel.preferred-height;
                background: Theme.palette-surface;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.palette-border;
                oversize-panel := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: "Note too large";
                        color: Theme.palette-foreground;
                        font-family: "Montserrat";
                        font-size: 16px;
                        font-weight: 600;
                    }
                    Text {
                        text: Compose.oversize-message;
                        color: Theme.palette-muted;
                        font-family: "Montserrat";
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        SecondaryAction {
                            horizontal-stretch: 1;
                            text: Compose.oversize-offer-bump ? "Cancel" : "OK";
                            clicked => { Compose.show-oversize = false; }
                        }
                        if Compose.oversize-offer-bump: PrimaryAction {
                            horizontal-stretch: 1;
                            text: "Switch to Standard";
                            clicked => { Callbacks.oversize-bump(); }
                        }
                    }
                }
            }
        }

        // Quantum-key Replace confirm — nested in root (sibling-app
        // overlay gotcha, same as the oversize dialog above).
        if DeviceQuantumKey.show-replace-confirm: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000088;
            TouchArea { }
            Rectangle {
                x: 24px;
                y: 90px + UISize.control-center-status-bar-height;
                width: parent.width - 48px;
                height: dqk-replace-panel.preferred-height;
                background: Theme.palette-surface;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.palette-border;
                dqk-replace-panel := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: "Replace this quantum key?";
                        color: Theme.palette-foreground;
                        font-family: "Montserrat";
                        font-size: 16px;
                        font-weight: 600;
                    }
                    Text {
                        text: "Notes sealed to the CURRENT key become permanently unreadable unless you already exported it. This can't be undone.";
                        color: Theme.palette-danger;
                        font-family: "Montserrat";
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        SecondaryAction {
                            horizontal-stretch: 1;
                            text: "Cancel";
                            clicked => { DeviceQuantumKey.show-replace-confirm = false; }
                        }
                        PrimaryAction {
                            horizontal-stretch: 1;
                            text: "Replace";
                            clicked => { Callbacks.device-quantum-key-replace-confirm(); }
                        }
                    }
                }
            }
        }

        // Quantum-key Delete confirm.
        if DeviceQuantumKey.show-delete-confirm: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000088;
            TouchArea { }
            Rectangle {
                x: 24px;
                y: 90px + UISize.control-center-status-bar-height;
                width: parent.width - 48px;
                height: dqk-delete-panel.preferred-height;
                background: Theme.palette-surface;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.palette-border;
                dqk-delete-panel := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: "Delete this quantum key?";
                        color: Theme.palette-foreground;
                        font-family: "Montserrat";
                        font-size: 16px;
                        font-weight: 600;
                    }
                    Text {
                        text: "Notes sealed to it become permanently unreadable unless you already exported it. This can't be undone.";
                        color: Theme.palette-danger;
                        font-family: "Montserrat";
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        SecondaryAction {
                            horizontal-stretch: 1;
                            text: "Cancel";
                            clicked => { DeviceQuantumKey.show-delete-confirm = false; }
                        }
                        PrimaryAction {
                            horizontal-stretch: 1;
                            text: "Delete";
                            clicked => { Callbacks.device-quantum-key-delete-confirm(); }
                        }
                    }
                }
            }
        }

        // Busy overlay — nested inside the root container (never a direct
        // Window child; sibling-app gotcha).
        if Ui.busy: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000088;
            TouchArea { }
            Rectangle {
                width: 220px;
                height: 80px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Theme.palette-surface;
                border-radius: 16px;
                Text {
                    text: "Working…";
                    color: Theme.palette-foreground;
                    font-family: "Montserrat";
                    font-size: 20px;
                    font-weight: 600;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }
}
