import { Theme, UISize, ButtonVariant, ButtonState, ControlSize, Images } from "@ui/theme.slint";
import { Screen, Callbacks, Ui, Home, Compose, ToRow, Confirm, ConfirmSign, ConfirmRow, Notes, NoteRow, View, Sync, SignPsbt, Settings, Contacts, ContactRow, Coins, CoinRow, Sweep, NotebooksUi, NotebookCb, NotebookRow, SenderRow, Recovery, ExportNbRow, Funding, FundingCoinRow, ChangePick, QuantumKeys, DeviceQuantumKey } from "callbacks.slint";
import { Button } from "@ui/button.slint";
import { PrimaryAction, SecondaryAction, ScreenHeader, PillOption, EditorField, NoteEntry, FundingCoinEntry, ChangeOptionRow, ContactEntry, ToRowEntry, ConfirmRowEntry } from "components.slint";
import { HomeScreen } from "screens/home.slint";
import { NotesScreen } from "screens/notes.slint";
import { NoteScreen } from "screens/note.slint";

export { Screen, Callbacks, Ui, Home, Compose, ToRow, Confirm, ConfirmSign, Notes, View, Sync, SignPsbt, Settings, Contacts, Coins, Sweep, NotebooksUi, NotebookCb, Recovery, Funding, ChangePick, QuantumKeys, DeviceQuantumKey, Theme, ButtonVariant, ButtonState, ControlSize, Images }


export component AppWindow inherits Window {
    title: "Graffito";
    preferred-width: 480px;
    preferred-height: 800px;
    background: Theme.palette-background;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.palette-background;

        // ------------------------------------------------ screen 0: home
        // A NOTEBOOK's home (its address, notes, compose). The header back
        // returns to the notebook list (screen 20 — the main screen).
        if Ui.screen == Screen.home: HomeScreen {
            width: parent.width;
            height: parent.height;
        }

        // ------------------------------------------- screen 1: notes list
        if Ui.screen == Screen.notes: NotesScreen {
            width: parent.width;
            height: parent.height;
        }

        // -------------------------------------------- screen 2: note view
        if Ui.screen == Screen.note: NoteScreen {
            width: parent.width;
            height: parent.height;
        }

        // ---------------------------------------------- screen 3: compose
        // Everything interactive stays in the top ~400px so the on-screen
        // keyboard never covers a control (sibling-app gotcha).
        if Ui.screen == Screen.compose: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 8px + UISize.control-center-status-bar-height;
            padding-bottom: 24px;
            spacing: 10px;

            ScreenHeader {
                vertical-stretch: 0;
                title: "Compose";
                // Back to the picker so the recipient can be changed
                // without losing the draft (Compose.text persists).
                back => { Callbacks.refresh-contacts(); Ui.screen = Screen.contacts; }
            }

            // Who this note goes to — set by the contacts picker; compose
            // itself has no address editing.
            Text {
                vertical-stretch: 0;
                text: Compose.to-label;
                color: Theme.palette-muted;
                font-family: "SourceCodePro";
                font-size: 14px;
                overflow: elide;
            }

            // Extra recipients (multi-recipient directed note): one row per
            // Compose.to-extra entry, each removable.
            for row in Compose.to-extra: ToRowEntry {
                vertical-stretch: 0;
                entry: row;
                remove => { Callbacks.remove-recipient(row.address); }
            }

            // "+ Add recipient" — only for an in-progress directed draft,
            // and only while under the 255-recipient cap.
            if Compose.to-address != "" && 1 + Compose.to-extra.length < 255: Rectangle {
                vertical-stretch: 0;
                height: 30px;
                TouchArea { clicked => { Callbacks.add-recipient-open(); } }
                HorizontalLayout {
                    Text {
                        text: "+ Add recipient";
                        color: Theme.palette-primary;
                        font-family: "Montserrat";
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "›";
                        color: Theme.palette-muted;
                        font-family: "Montserrat";
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }

            // Pay-from (funding-unification): who funds this note —
            // notebook, spending wallet, or a mix. Compact nav row, like
            // the gift panel's header, opening the picker (screen 25).
            Rectangle {
                vertical-stretch: 0;
                height: 34px;
                TouchArea { clicked => { Callbacks.funding-open(); Ui.screen = Screen.pay-from; } }
                HorizontalLayout {
                    Text {
                        text: "Pay from · " + Compose.pay-from-label;
                        color: Theme.palette-foreground;
                        font-family: "Montserrat";
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: Compose.pay-from-balance + "  ›";
                        color: Theme.palette-muted;
                        font-family: "SourceCodePro";
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
            // Change destination (screen 26).
            Rectangle {
                vertical-stretch: 0;
                height: 30px;
                TouchArea { clicked => { Callbacks.change-open(); Ui.screen = Screen.change; } }
                HorizontalLayout {
                    Text {
                        text: "Change · " + Compose.change-label;
                        color: Theme.palette-muted;
                        font-family: "Montserrat";
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "›";
                        color: Theme.palette-muted;
                        font-family: "Montserrat";
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 8px;
                PillOption {
                    label: "Private";
                    selected: Compose.private-note;
                    horizontal-stretch: 1;
                    tapped => { Compose.private-note = true; Callbacks.compose-changed(); }
                }
                PillOption {
                    label: "Public";
                    selected: !Compose.private-note;
                    horizontal-stretch: 1;
                    tapped => { Compose.private-note = false; Callbacks.compose-changed(); }
                }
            }

            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 6px;
                PillOption {
                    label: "Economy";
                    selected: Compose.tier == 0;
                    horizontal-stretch: 1;
                    tapped => { Compose.tier = 0; Callbacks.compose-changed(); }
                }
                PillOption {
                    label: "Normal";
                    selected: Compose.tier == 1;
                    horizontal-stretch: 1;
                    tapped => { Compose.tier = 1; Callbacks.compose-changed(); }
                }
                PillOption {
                    label: "Fast";
                    selected: Compose.tier == 2;
                    horizontal-stretch: 1;
                    tapped => { Compose.tier = 2; Callbacks.compose-changed(); }
                }
                PillOption {
                    label: "Custom";
                    selected: Compose.tier == 3;
                    horizontal-stretch: 1;
                    tapped => { Compose.tier = 3; Callbacks.compose-changed(); }
                }
            }

            // Custom fee-rate field — revealed ONLY when the Custom tier is
            // selected (tapping the pill above is the toggle). The three
            // preset tiers need no field, so it stays out of the way.
            if Compose.tier == 3: HorizontalLayout {
                vertical-stretch: 0;
                spacing: 8px;
                Rectangle {
                    height: 44px;
                    horizontal-stretch: 1;
                    background: Theme.palette-surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: rate-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                    clip: true;
                    rate-input := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        height: 24px;
                        y: (parent.height - self.height) / 2;
                        text <=> Compose.rate-text;
                        color: Theme.palette-foreground;
                        font-family: "SourceCodePro";
                        font-size: 18px;
                        single-line: true;
                        edited => { Callbacks.compose-changed(); }
                        accepted => { self.clear-focus(); }
                    }
                }
                Text {
                    text: "sat/vB";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 16px;
                    vertical-alignment: center;
                }
            }

            // Gift amount — directed notes only. Collapsible panel (styled
            // like the compose panels): the recipient output carries this
            // many sats instead of the default dust. Default/min = 330.
            if Compose.to-address != "": Rectangle {
                vertical-stretch: 0;
                border-radius: 12px;
                background: Theme.palette-surface;
                border-width: 1px;
                border-color: Theme.palette-border;
                height: gift-col.preferred-height;
                gift-col := VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    Rectangle {
                        height: 22px;
                        TouchArea { clicked => { Compose.gift-expanded = !Compose.gift-expanded; } }
                        HorizontalLayout {
                            Text {
                                text: "Gift · \{Compose.gift-sats} sats";
                                color: Theme.palette-muted;
                                font-family: "SourceCodePro";
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                            Rectangle { }
                            Image {
                                source: Compose.gift-expanded
                                    ? @image-url("../resources/icons/chevron-up.svg")
                                    : @image-url("../resources/icons/chevron-down.svg");
                                colorize: Theme.palette-muted;
                                width: 16px;
                                height: 16px;
                                y: (parent.height - 16px) / 2;
                            }
                        }
                    }
                    if Compose.gift-expanded: Text {
                        text: "Sats sent to the recipient with your note. Minimum 330 (dust).";
                        color: Theme.palette-muted;
                        font-family: "SourceCodePro";
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if Compose.gift-expanded: Rectangle {
                        height: 44px;
                        background: Theme.palette-background;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: gift-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                        clip: true;
                        gift-input := TextInput {
                            x: 14px;
                            width: parent.width - 28px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            text <=> Compose.gift-sats;
                            color: Theme.palette-foreground;
                            font-family: "SourceCodePro";
                            font-size: 18px;
                            single-line: true;
                            input-type: number;
                            edited => { Callbacks.compose-changed(); }
                            accepted => { self.clear-focus(); }
                        }
                    }
                }
            }

            // Post-quantum Security section — a directed private single-
            // recipient note, OR a private self-note (no recipient —
            // PLAN-graffito-self-pw.md; notebook-funded only, same as the
            // directed case). Passphrase (Argon2id) is available either
            // way; ML-KEM stays directed-only (Compose.pq-mlkem-eligible),
            // since a self-note's KEM receive key would derive from the
            // same leaf as its enc key.
            if Compose.pq-eligible: Rectangle {
                vertical-stretch: 0;
                border-radius: 12px;
                background: Theme.palette-surface;
                border-width: 1px;
                border-color: Theme.palette-border;
                height: security-col.preferred-height;
                security-col := VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    Text {
                        text: "Quantum-safe security";
                        color: Theme.palette-foreground;
                        font-family: "Montserrat";
                        font-size: 14px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        PillOption {
                            label: "Passphrase";
                            selected: Compose.pq-passphrase-active;
                            horizontal-stretch: 1;
                            tapped => {
                                Compose.pq-passphrase-active = !Compose.pq-passphrase-active;
                                Callbacks.compose-changed();
                            }
                        }
                        if Compose.pq-mlkem-eligible: PillOption {
                            label: "ML-KEM";
                            selected: Compose.pq-mlkem-active;
                            horizontal-stretch: 1;
                            opacity: Compose.pq-mlkem-available ? 1.0 : 0.4;
                            tapped => {
                                Compose.pq-mlkem-active = !Compose.pq-mlkem-active;
                                Callbacks.compose-changed();
                            }
                        }
                    }
                    if Compose.pq-passphrase-active: HorizontalLayout {
                        height: 44px;
                        spacing: 8px;
                        Rectangle {
                            height: 44px;
                            horizontal-stretch: 1;
                            background: Theme.palette-background;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: pq-pass-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                            clip: true;
                            pq-pass-input := TextInput {
                                x: 14px;
                                width: parent.width - 28px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                text <=> Compose.pq-passphrase-text;
                                color: Theme.palette-foreground;
                                font-family: "SourceCodePro";
                                font-size: 15px;
                                single-line: true;
                                edited => { Callbacks.pq-passphrase-changed(); }
                                accepted => { self.clear-focus(); }
                            }
                        }
                        SecondaryAction {
                            // Sibling SecondaryActions all use width: 100%
                            // (they're the sole control in their row); this
                            // one shares a row with the passphrase field, so
                            // it needs an explicit width AND a font-size/
                            // padding that actually fit "Generate" — the
                            // previous 90px at the component's default 20px
                            // font + 20px horizontal padding left no room
                            // for the label (elided down to nothing, a
                            // narrow empty pill).
                            width: 108px;
                            font-size: 15px;
                            padding-horizontal: 12px;
                            text: "Generate";
                            clicked => { Callbacks.pq-generate-passphrase(); }
                        }
                    }
                    if Compose.pq-passphrase-active: Text {
                        text: Compose.pq-passphrase-strength;
                        color: Compose.pq-passphrase-weak ? Theme.palette-danger : Theme.palette-muted;
                        font-family: "SourceCodePro";
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if Compose.pq-mlkem-eligible && (Compose.pq-mlkem-active || !Compose.pq-mlkem-available): Text {
                        text: Compose.pq-mlkem-caption;
                        color: Theme.palette-muted;
                        font-family: "SourceCodePro";
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if Compose.pq-security-label != "": Text {
                        text: Compose.pq-security-label;
                        color: Theme.palette-primary;
                        font-family: "SourceCodePro";
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            editor := EditorField {
                vertical-stretch: 0;
                // The To row moved to the contacts picker; only a small
                // to-label remains above, so the editor gets its height
                // back while Continue stays above the on-screen keyboard.
                height: 118px;
                text <=> Compose.text;
                placeholder: "Type your note…";
                changed => { Callbacks.compose-changed(); }
                // Keyboard Done: the system keyboard's Done key sends a
                // plain '\n'; Rust strips it and bumps dismiss-nonce —
                // dropping focus here hides the keyboard (IMR Disable).
                property <int> dn: Compose.dismiss-nonce;
                changed dn => { self.clear-focus(); }
            }

            // Live cost readout — updates every keystroke.
            Text {
                vertical-stretch: 0;
                text: Compose.cost-line;
                color: Theme.palette-muted;
                font-family: "SourceCodePro";
                font-size: 14px;
                wrap: word-wrap;
            }

            PrimaryAction {
                vertical-stretch: 0;
                width: 100%;
                text: "Continue";
                disabled: !Compose.can-continue;
                clicked => {
                    editor.clear-focus();
                    Callbacks.compose-continue();
                }
            }

            Rectangle { vertical-stretch: 1; }
        }

        // ----------------------------------- screen 4: universal Confirm & sign
        // Shared by compose/sweep/consolidate/external-PSBT: every fact shown
        // here is decoded from the actual (un)signed tx bytes by notes-core's
        // `confirm::summarize_signed_tx` — never from the app's own intent —
        // so it's the last line of defense before anything hits the wire.
        // The Flickable stretches so the Sign button stays pinned at the
        // screen's true bottom regardless of how many rows there are.
        if Ui.screen == Screen.confirm-sign: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px + UISize.control-center-status-bar-height;
            padding-bottom: 24px;
            spacing: 10px;

            ScreenHeader {
                vertical-stretch: 0;
                title: "Confirm & sign";
                back => { Callbacks.confirm-cancel(); }
            }

            Flickable {
                vertical-stretch: 1;
                viewport-width: self.width;
                viewport-height: confirm-content.preferred-height;
                confirm-content := VerticalLayout {
                    width: parent.width;
                    spacing: 12px;

                    Text {
                        text: ConfirmSign.context;
                        color: Theme.palette-muted;
                        font-family: "Montserrat";
                        font-size: 14px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "txid: " + ConfirmSign.txid;
                        color: Theme.palette-muted;
                        font-family: "SourceCodePro";
                        font-size: 12px;
                        wrap: char-wrap;
                    }

                    if ConfirmSign.warn != "": Rectangle {
                        background: #332400;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #eab308;
                        VerticalLayout {
                            padding: 12px;
                            Text {
                                text: "Heads up: " + ConfirmSign.warn;
                                color: #eab308;
                                font-family: "Montserrat";
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if ConfirmSign.note != "": Rectangle {
                        background: Theme.palette-surface;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.palette-border;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;
                            Text {
                                text: "NOTE";
                                color: Theme.palette-muted;
                                font-family: "Montserrat";
                                font-size: 12px;
                                font-weight: 700;
                            }
                            Text {
                                text: ConfirmSign.note;
                                color: Theme.palette-foreground;
                                font-family: "SourceCodePro";
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Text {
                        text: "INPUTS";
                        color: Theme.palette-muted;
                        font-family: "Montserrat";
                        font-size: 12px;
                        font-weight: 700;
                    }
                    VerticalLayout {
                        spacing: 6px;
                        for row in ConfirmSign.inputs: ConfirmRowEntry { entry: row; }
                    }

                    Text {
                        text: "OUTPUTS";
                        color: Theme.palette-muted;
                        font-family: "Montserrat";
                        font-size: 12px;
                        font-weight: 700;
                    }
                    VerticalLayout {
                        spacing: 6px;
                        for row in ConfirmSign.outputs: ConfirmRowEntry { entry: row; }
                    }

                    Rectangle {
                        background: Theme.palette-surface;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.palette-border;
                        VerticalLayout {
                            padding: 12px;
                            Text {
                                text: "Fee: " + ConfirmSign.fee-line;
                                color: Theme.palette-foreground;
                                font-family: "SourceCodePro";
                                font-size: 14px;
                                font-weight: 600;
                            }
                        }
                    }

                    // Honest-fee-label (2026-07-19): the fee row above is
                    // ALREADY the real network fee at this rate — this row
                    // names the separate sub-dust leftover riding on top of
                    // it (folded into the fee because it's too small to be
                    // its own change output), so the total never reads as
                    // an unexplained/inflated fee. Warn-tinted like the
                    // banner above, but its own key:value row (a specific
                    // fact, not a general advisory).
                    if ConfirmSign.fold != "": Rectangle {
                        background: Theme.palette-surface;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #eab308;
                        VerticalLayout {
                            padding: 12px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Leftover (dust rule)";
                                    color: #eab308;
                                    font-family: "Montserrat";
                                    font-size: 13px;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: ConfirmSign.fold;
                                    color: #eab308;
                                    font-family: "SourceCodePro";
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                            }
                        }
                    }
                }
            }

            Text {
                vertical-stretch: 0;
                text: "Signing spends real sats and writes this to the blockchain forever.";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }

            PrimaryAction {
                vertical-stretch: 0;
                width: 100%;
                text: ConfirmSign.sign-label;
                clicked => { Callbacks.confirm-sign(); }
            }
        }

        // ------------------------------------------------- screen 5: sync
        if Ui.screen == Screen.sync: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px + UISize.control-center-status-bar-height;
            padding-bottom: 24px;
            spacing: 14px;

            ScreenHeader {
                title: "Sync";
                back => { Sync.picking = false; Callbacks.refresh-home(); Ui.screen = Screen.home; }
            }

            Text {
                text: Sync.status;
                color: Theme.palette-foreground;
                font-family: "SourceCodePro";
                font-size: 15px;
                wrap: word-wrap;
            }

            // Normal actions — hidden while the import picker is open.
            if !Sync.picking: VerticalLayout {
                spacing: 14px;
                PrimaryAction {
                    width: 100%;
                    text: "Import sync bundle";
                    clicked => { Callbacks.list-bundles(); }
                }
                SecondaryAction {
                    width: 100%;
                    text: "Export pending txs";
                    clicked => { Callbacks.export-pending(); }
                }
                SecondaryAction {
                    width: 100%;
                    text: "Scan bundle 📷";
                    clicked => { Callbacks.scan-bundle(); }
                }
                SecondaryAction {
                    width: 100%;
                    text: "Sign external tx ✍";
                    clicked => { Callbacks.sign-psbt(); }
                }
            }

            // Import picker: the actual files found in the inboxes, so the
            // user chooses one (no silent auto-pick). Empty → instructions.
            if Sync.picking: VerticalLayout {
                spacing: 10px;
                Text {
                    text: "Choose a bundle to import";
                    color: Theme.palette-foreground;
                    font-family: "Montserrat";
                    font-size: 16px;
                    font-weight: 600;
                }
                for b in Sync.bundles: SecondaryAction {
                    width: 100%;
                    text: b.label;
                    clicked => { Callbacks.pick-bundle(b.name, b.loc); }
                }
                if Sync.bundles.length == 0: Text {
                    text: Sync.empty-hint;
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 14px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    SecondaryAction {
                        horizontal-stretch: 1;
                        text: "Refresh";
                        clicked => { Callbacks.list-bundles(); }
                    }
                    SecondaryAction {
                        horizontal-stretch: 1;
                        text: "Cancel";
                        clicked => { Sync.picking = false; }
                    }
                }
            }

            Text {
                text: Sync.result;
                color: Ui.error == "" ? Theme.palette-muted : Theme.palette-danger;
                font-family: "SourceCodePro";
                font-size: 14px;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; }

            Text {
                text: "Bundles: /graffito/inbox on Internal or Airlock.\nSigned txs land in /graffito/outbox.";
                color: Theme.palette-muted;
                font-family: "SourceCodePro";
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        // -------------------------------------------- screen 8: signed PSBT
        if Ui.screen == Screen.signed: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px + UISize.control-center-status-bar-height;
            padding-bottom: 24px;
            spacing: 14px;

            ScreenHeader {
                title: "Signed";
                back => { Ui.screen = SignPsbt.back-screen; }
            }
            Text {
                text: SignPsbt.summary;
                color: Theme.palette-foreground;
                font-family: "SourceCodePro";
                font-size: 15px;
                wrap: word-wrap;
            }
            if SignPsbt.has-qr: HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 264px;
                    height: 264px;
                    background: #FFFFFF;
                    border-radius: 12px;
                    Image {
                        source: SignPsbt.qr;
                        width: 240px;
                        height: 240px;
                        x: 12px;
                        y: 12px;
                    }
                }
            }
            Text {
                text: "Scan this with the companion or desktop app to broadcast. Also saved to /graffito/outbox.";
                color: Theme.palette-muted;
                font-family: "SourceCodePro";
                font-size: 13px;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
            PrimaryAction {
                width: 100%;
                text: "Done";
                clicked => { Callbacks.refresh-home(); Ui.screen = Screen.home; }
            }
        }

        // ------------------------------------ screen 9: coins (viewer-first)
        // The UTXO ledger as of the last sync bundle. ONE action — the
        // consolidate button on top — opens the shared sweep screen (10).
        if Ui.screen == Screen.coins: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px + UISize.control-center-status-bar-height;
            padding-bottom: 24px;
            spacing: 12px;

            ScreenHeader {
                title: "Wallet coins";
                back => { Ui.screen = Screen.settings; }
            }

            Text {
                text: Coins.summary;
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 17px;
                font-weight: 600;
            }

            PrimaryAction {
                width: 100%;
                text: "Consolidate wallet…";
                disabled: !Coins.can-consolidate;
                clicked => { Callbacks.consolidate-open(); }
            }

            if !Coins.can-consolidate: Text {
                text: Coins.rows.length == 0
                    ? "No spendable coins anywhere — fund a notebook's address and import a sync bundle."
                    : "Nothing to consolidate — the wallet already holds a single coin.";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                wrap: word-wrap;
            }

            Flickable {
                vertical-stretch: 1;
                viewport-height: Coins.rows.length * 72px;
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    for coin in Coins.rows: Rectangle {
                        height: 64px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.palette-border;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            Text {
                                text: coin.label;
                                color: Theme.palette-foreground;
                                font-family: "Montserrat";
                                font-size: 18px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: coin.meta;
                                color: Theme.palette-muted;
                                font-family: "SourceCodePro";
                                font-size: 13px;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }

        // ---------------------- screen 10: sweep / consolidate (compose-like)
        // Shared flow: destination line (picker- or self-set), fee tiers with
        // the collapse-on-Custom rate field, read-only inputs summary, live
        // cost line. A sweep spends ALL coins by design — no coin picking.
        if Ui.screen == Screen.sweep: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 8px + UISize.control-center-status-bar-height;
            padding-bottom: 24px;
            spacing: 10px;

            ScreenHeader {
                vertical-stretch: 0;
                title: Sweep.kind == "consolidate" ? "Consolidate" : "Sweep";
                // Sweep: back to the destination picker (still in sweep
                // mode); consolidate: back to the coins list.
                back => {
                    if Sweep.kind == "consolidate" {
                        Callbacks.refresh-coins();
                        Ui.screen = Screen.coins;
                    } else {
                        Callbacks.refresh-contacts();
                        Ui.screen = Screen.contacts;
                    }
                }
            }

            Text {
                vertical-stretch: 0;
                text: Sweep.dest-label;
                color: Theme.palette-muted;
                font-family: "SourceCodePro";
                font-size: 14px;
                overflow: elide;
            }

            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 6px;
                PillOption {
                    label: "Economy";
                    selected: Sweep.tier == 0;
                    horizontal-stretch: 1;
                    tapped => { Sweep.tier = 0; Callbacks.sweep-changed(); }
                }
                PillOption {
                    label: "Normal";
                    selected: Sweep.tier == 1;
                    horizontal-stretch: 1;
                    tapped => { Sweep.tier = 1; Callbacks.sweep-changed(); }
                }
                PillOption {
                    label: "Fast";
                    selected: Sweep.tier == 2;
                    horizontal-stretch: 1;
                    tapped => { Sweep.tier = 2; Callbacks.sweep-changed(); }
                }
                PillOption {
                    label: "Custom";
                    selected: Sweep.tier == 3;
                    horizontal-stretch: 1;
                    tapped => { Sweep.tier = 3; Callbacks.sweep-changed(); }
                }
            }

            if Sweep.tier == 3: HorizontalLayout {
                vertical-stretch: 0;
                spacing: 8px;
                Rectangle {
                    height: 44px;
                    horizontal-stretch: 1;
                    background: Theme.palette-surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: sweep-rate-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                    clip: true;
                    sweep-rate-input := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        height: 24px;
                        y: (parent.height - self.height) / 2;
                        text <=> Sweep.rate-text;
                        color: Theme.palette-foreground;
                        font-family: "SourceCodePro";
                        font-size: 18px;
                        single-line: true;
                        edited => { Callbacks.sweep-changed(); }
                        accepted => { self.clear-focus(); }
                    }
                }
                Text {
                    text: "sat/vB";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 16px;
                    vertical-alignment: center;
                }
            }

            // Read-only inputs summary — a sweep always spends every coin.
            Rectangle {
                vertical-stretch: 0;
                border-radius: 12px;
                background: Theme.palette-surface;
                border-width: 1px;
                border-color: Theme.palette-border;
                height: 42px;
                Text {
                    x: 14px;
                    width: parent.width - 28px;
                    height: parent.height;
                    text: Sweep.inputs-line;
                    color: Theme.palette-muted;
                    font-family: "SourceCodePro";
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            Text {
                vertical-stretch: 0;
                text: Sweep.cost-line;
                color: Theme.palette-muted;
                font-family: "SourceCodePro";
                font-size: 14px;
                wrap: word-wrap;
            }

            PrimaryAction {
                vertical-stretch: 0;
                width: 100%;
                text: "Continue";
                disabled: !Sweep.can-continue;
                clicked => { Callbacks.sweep-continue(); }
            }

            Rectangle { vertical-stretch: 1; }
        }

        // -------------------------------------------- screen 6: settings
        if Ui.screen == Screen.settings: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px + UISize.control-center-status-bar-height;
            padding-bottom: 0;
            spacing: 14px;

            ScreenHeader {
                title: "Settings";
                back => { Ui.screen = Screen.notebooks; }
            }

            // Settings has grown (Coins/Sweep, chunk, Accounts, the whole
            // Dangerous area) — scroll the body, keep the header fixed.
            Flickable {
                vertical-stretch: 1;
                viewport-width: self.width;
                viewport-height: s6-content.preferred-height;
                s6-content := VerticalLayout {
                    spacing: 14px;
                    padding-bottom: 24px;

                    SecondaryAction {
                        width: 100%;
                        text: "Network: " + Home.network;
                        clicked => { Callbacks.cycle-network(); }
                    }

            // Funds — viewer-first Coins (consolidate lives there) and the
            // sweep flow (destination picked first, compose-like screen).
            HorizontalLayout {
                spacing: 8px;
                SecondaryAction {
                    horizontal-stretch: 1;
                    text: "Coins";
                    clicked => {
                        Callbacks.refresh-coins();
                        Ui.screen = Screen.coins;
                    }
                }
                SecondaryAction {
                    horizontal-stretch: 1;
                    text: "Sweep funds…";
                    disabled: Home.address == "";
                    clicked => {
                        Contacts.pick-mode = "sweep";
                        Callbacks.refresh-contacts();
                        Ui.screen = Screen.contacts;
                    }
                }
            }

            Text {
                text: Settings.chunk-error == "" ? "OP_RETURN chunk size" : Settings.chunk-error;
                color: Settings.chunk-error == "" ? Theme.palette-muted : Theme.palette-danger;
                font-family: "Montserrat";
                font-size: 14px;
            }
            HorizontalLayout {
                spacing: 6px;
                PillOption {
                    label: "Standard";
                    selected: Settings.chunk-mode == 0;
                    horizontal-stretch: 1;
                    tapped => { Settings.chunk-mode = 0; Callbacks.chunk-changed(); }
                }
                PillOption {
                    label: "80 compat";
                    selected: Settings.chunk-mode == 1;
                    horizontal-stretch: 1;
                    tapped => { Settings.chunk-mode = 1; Callbacks.chunk-changed(); }
                }
                PillOption {
                    label: "Custom";
                    selected: Settings.chunk-mode == 2;
                    horizontal-stretch: 1;
                    tapped => { Settings.chunk-mode = 2; Callbacks.chunk-changed(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    height: 44px;
                    horizontal-stretch: 1;
                    background: Theme.palette-surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: chunk-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                    clip: true;
                    chunk-input := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        height: 24px;
                        y: (parent.height - self.height) / 2;
                        text <=> Settings.chunk-text;
                        color: Theme.palette-foreground;
                        font-family: "SourceCodePro";
                        font-size: 18px;
                        single-line: true;
                        edited => {
                            Settings.chunk-mode = 2;
                            Callbacks.chunk-changed();
                        }
                        accepted => { self.clear-focus(); }
                    }
                }
                Text {
                    text: "bytes";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 16px;
                    vertical-alignment: center;
                }
            }


            Text {
                text: "Chunk size caps each OP_RETURN output. Standard (100000) matches Bitcoin Core v30 relay defaults, verified on mempool.space; pick 80 if your broadcast endpoint rejects a note, then recompose it.";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                wrap: word-wrap;
            }

            Text {
                text: Settings.locktime-error == "" ? Settings.locktime-effective : Settings.locktime-error;
                color: Settings.locktime-error == "" ? Theme.palette-muted : Theme.palette-danger;
                font-family: "Montserrat";
                font-size: 14px;
            }
            HorizontalLayout {
                spacing: 6px;
                PillOption {
                    label: "Chain height";
                    selected: Settings.locktime-mode == 0;
                    horizontal-stretch: 1;
                    tapped => { Settings.locktime-mode = 0; Callbacks.locktime-changed(); }
                }
                PillOption {
                    label: "Zero";
                    selected: Settings.locktime-mode == 1;
                    horizontal-stretch: 1;
                    tapped => { Settings.locktime-mode = 1; Callbacks.locktime-changed(); }
                }
                PillOption {
                    label: "Custom";
                    selected: Settings.locktime-mode == 2;
                    horizontal-stretch: 1;
                    tapped => { Settings.locktime-mode = 2; Callbacks.locktime-changed(); }
                }
            }
            // The height field is only meaningful for Custom — same
            // collapse-on-Custom rule the compose screen's rate field uses.
            if Settings.locktime-mode == 2: HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    height: 44px;
                    horizontal-stretch: 1;
                    background: Theme.palette-surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: locktime-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                    clip: true;
                    locktime-input := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        height: 24px;
                        y: (parent.height - self.height) / 2;
                        text <=> Settings.locktime-text;
                        color: Theme.palette-foreground;
                        font-family: "SourceCodePro";
                        font-size: 18px;
                        single-line: true;
                        edited => {
                            Settings.locktime-mode = 2;
                            Callbacks.locktime-changed();
                        }
                        accepted => { self.clear-focus(); }
                    }
                }
                Text {
                    text: "height";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 16px;
                    vertical-alignment: center;
                }
            }

            // The wallet-context switcher (accounts) is a normal setting.
            SecondaryAction {
                width: 100%;
                text: "Accounts…";
                clicked => { Ui.screen = Screen.accounts; }
            }

            // Post-quantum (pq.rs): this notebook's ML-KEM receive
            // identity — level picker, fingerprint, public-key QR to hand
            // to a contact. Public-key export only.
            SecondaryAction {
                width: 100%;
                text: "Quantum keys…";
                clicked => { Callbacks.open-quantum-keys(); Ui.screen = Screen.quantum-keys; }
            }

            // Personal device quantum key (PLAN-graffito-quantum-key.md):
            // a single NON-seed-derived ML-KEM keypair — generate/import,
            // export, replace, delete. Distinct from "Quantum keys…"
            // above (those are per-notebook and seed-derived); this one
            // is what a private SELF-note's ML-KEM pill seals against.
            SecondaryAction {
                width: 100%;
                text: "Quantum key…";
                clicked => { Callbacks.open-device-quantum-key(); Ui.screen = Screen.device-quantum-key; }
            }

            // Spending wallet (funding-unification): an optional BIP-84
            // native-segwit wallet (same seed) that holds funds instead of
            // the notebook, scoped to the active (network, seed, account).
            Rectangle {
                height: 1px;
                background: Theme.palette-border;
            }
            Text {
                text: "Separate spending wallet";
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 15px;
                font-weight: 600;
            }
            Text {
                text: "Fresh bc1q addresses hold your funds instead of the notebook — protects your balance and pubkey behind fresh-address hygiene. Costs a little more per note, and a shared spending pool publicly links the notes it pays for.";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                PillOption {
                    label: "Off";
                    selected: !Settings.spending-enabled;
                    horizontal-stretch: 1;
                    tapped => { Callbacks.set-spending-enabled(false); }
                }
                PillOption {
                    label: "On";
                    selected: Settings.spending-enabled;
                    horizontal-stretch: 1;
                    tapped => { Callbacks.set-spending-enabled(true); }
                }
            }
            if Settings.spending-enabled: VerticalLayout {
                spacing: 10px;
                Image {
                    source: Settings.spending-qr;
                    width: 150px;
                    height: 150px;
                    image-rendering: pixelated;
                    x: (parent.width - self.width) / 2;
                }
                Text {
                    text: Settings.spending-address;
                    color: Theme.palette-muted;
                    font-family: "SourceCodePro";
                    font-size: 12px;
                    wrap: char-wrap;
                    horizontal-alignment: center;
                }
                Text {
                    text: Settings.spending-balance-line;
                    color: Theme.palette-foreground;
                    font-family: "Montserrat";
                    font-size: 17px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Next receive address, above. Paste every address below into the companion's \"Spending wallet addresses\" field so it can find this wallet's coins on the next sync — the companion otherwise only scans the notebook.";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 76px;
                    background: Theme.palette-surface;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.palette-border;
                    clip: true;
                    Flickable {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        height: parent.height - 16px;
                        viewport-height: max(self.height, addr-text.preferred-height);
                        addr-text := Text {
                            width: parent.width;
                            text: Settings.spending-addresses-text == "" ? "No addresses used yet." : Settings.spending-addresses-text;
                            color: Theme.palette-muted;
                            font-family: "SourceCodePro";
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }

                // Companion watch window (funding-unification gap-discovery,
                // option (b), 2026-07-19): the next 20 receive + 20 change
                // addresses, exported so the companion can probe AHEAD of
                // what the device has revealed/spent — the piece that makes
                // a restore (or an external deposit to a not-yet-shown
                // address) still findable on the next sync.
                Rectangle {
                    height: 1px;
                    background: Theme.palette-border;
                }
                Text {
                    text: "Companion watch window";
                    color: Theme.palette-foreground;
                    font-family: "Montserrat";
                    font-size: 13px;
                    font-weight: 600;
                }
                Text {
                    text: "Next 20 receive + 20 change addresses this wallet could use next. Paste the whole block below into the companion's \"Spending wallet addresses\" field (or scan the QR) so it can find coins at addresses you haven't revealed or spent yet — this is what makes a restore converge.";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Image {
                    source: Settings.spending-window-qr;
                    width: 150px;
                    height: 150px;
                    image-rendering: pixelated;
                    x: (parent.width - self.width) / 2;
                }
                Rectangle {
                    height: 76px;
                    background: Theme.palette-surface;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.palette-border;
                    clip: true;
                    Flickable {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        height: parent.height - 16px;
                        viewport-height: max(self.height, window-text.preferred-height);
                        window-text := Text {
                            width: parent.width;
                            text: Settings.spending-window-text;
                            color: Theme.palette-muted;
                            font-family: "SourceCodePro";
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // ---- Dangerous area: reveal keys, grouped by risk ----
            // Recovery words + exports are all REVEALS; split by what a
            // captured value costs you — public (watch-only) vs private
            // (spends + decrypts). (Sal 2026-07-13.)
            Rectangle {
                height: 1px;
                background: Theme.palette-danger;
            }
            Text {
                text: "Dangerous area";
                color: Theme.palette-danger;
                font-family: "Montserrat";
                font-size: 13px;
                font-weight: 700;
            }
            Text {
                text: "These show secrets on screen. Reveal only somewhere private — no cameras, no one watching over your shoulder.";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                wrap: word-wrap;
            }
            SecondaryAction {
                width: 100%;
                text: "Public keys…";
                disabled: !Recovery.seed-available;
                clicked => {
                    Callbacks.reveal-public();
                    Ui.screen = Screen.public-keys;
                }
            }
            Text {
                text: "Account xpub + descriptor. Watch-only — safe to share so someone can see this account's balance; can't spend or read private notes.";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 12px;
                wrap: word-wrap;
            }
            SecondaryAction {
                width: 100%;
                text: "Private keys…";
                disabled: !Recovery.seed-available;
                clicked => {
                    Callbacks.reveal-private();
                    Ui.screen = Screen.private-keys;
                }
            }
            Text {
                text: "Recovery words + a notebook's raw key (hex/WIF). Anyone who sees these controls the coins and can read every private note. Keep them off cameras and out of sight.";
                color: Theme.palette-danger;
                font-family: "Montserrat";
                font-size: 12px;
                wrap: word-wrap;
            }

                }
            }
        }

        // ----------------------------------------- screen 21: accounts
        // Wallet-context switcher only (rotation seed index + BIP-86
        // account). The words reveal lives on its own screen (22), reached
        // from a separate Settings entry.
        if Ui.screen == Screen.accounts: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px + UISize.control-center-status-bar-height;
            padding-bottom: 24px;
            spacing: 12px;

            ScreenHeader {
                title: "Accounts";
                back => { Ui.screen = Screen.settings; }
            }

            // Recovery seed — its own row with an explanation.
            Text {
                text: "Recovery seed";
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 15px;
                font-weight: 600;
            }
            Text {
                text: "The 24-word phrase that backs up this wallet. Move to a fresh index only if a phrase is ever exposed — old words keep old keys, so sweep funds first.";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                wrap: word-wrap;
            }
            Rectangle {
                height: 44px;
                background: Theme.palette-surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: seed-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                clip: true;
                seed-input := TextInput {
                    x: 14px;
                    width: parent.width - 28px;
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                    text <=> Recovery.seed-text;
                    color: Theme.palette-foreground;
                    font-family: "SourceCodePro";
                    font-size: 18px;
                    single-line: true;
                    edited => { Recovery.saved-msg = ""; Recovery.context-error = ""; }
                    accepted => { self.clear-focus(); }
                }
            }

            // Account — its own row with an explanation.
            Text {
                text: "Account";
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 15px;
                font-weight: 600;
            }
            Text {
                text: "A separate wallet under this seed — its own notebooks, coins, and addresses. Keep separate accounts for separate purposes.";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                wrap: word-wrap;
            }
            Rectangle {
                height: 44px;
                background: Theme.palette-surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: account-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                clip: true;
                account-input := TextInput {
                    x: 14px;
                    width: parent.width - 28px;
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                    text <=> Recovery.account-text;
                    color: Theme.palette-foreground;
                    font-family: "SourceCodePro";
                    font-size: 18px;
                    single-line: true;
                    edited => { Recovery.saved-msg = ""; Recovery.context-error = ""; }
                    accepted => { self.clear-focus(); }
                }
            }

            SecondaryAction {
                width: 100%;
                text: "Save";
                clicked => { Callbacks.set-context(); }
            }
            // Inline feedback: validation error (red) or the saved
            // confirmation (accent) — the Switch stays on this screen.
            if Recovery.context-error != "": Text {
                text: Recovery.context-error;
                color: Theme.palette-danger;
                font-family: "Montserrat";
                font-size: 13px;
                wrap: word-wrap;
            }
            if Recovery.context-error == "" && Recovery.saved-msg != "": Text {
                text: Recovery.saved-msg;
                color: Theme.palette-primary;
                font-family: "Montserrat";
                font-size: 13px;
                wrap: word-wrap;
            }

            // The recovery-phrase backup lives on its own screen (22),
            // reached from a SEPARATE Settings entry — a pointer here so
            // the two tasks are clearly distinct.
            Text {
                text: "To back up or rotate a seed, use \"Private keys…\" in Settings — its Seed words show the 24-word phrase for the selected seed index.";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; }
        }

        // ---------------------------------- screen 22: recovery words
        // Dedicated reveal, reached straight from Settings. Words/SeedQR
        // for the active seed; Back → Settings, clearing them
        // (reveal-close). Fits comfortably on its own, no scrolling.
        if Ui.screen == Screen.recovery-words: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px + UISize.control-center-status-bar-height;
            padding-bottom: 24px;
            spacing: 14px;

            ScreenHeader {
                title: "Recovery words";
                back => {
                    Callbacks.reveal-close();
                    Ui.screen = Screen.settings;
                }
            }

            Text {
                text: Recovery.title-line;
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 16px;
                font-weight: 600;
            }

            if !Recovery.show-qr: HorizontalLayout {
                spacing: 16px;
                Text {
                    text: Recovery.words-col1;
                    color: Theme.palette-foreground;
                    font-family: "SourceCodePro";
                    font-size: 16px;
                    horizontal-stretch: 1;
                }
                Text {
                    text: Recovery.words-col2;
                    color: Theme.palette-foreground;
                    font-family: "SourceCodePro";
                    font-size: 16px;
                    horizontal-stretch: 1;
                }
            }
            if Recovery.show-qr: HorizontalLayout {
                alignment: center;
                Image {
                    source: Recovery.qr;
                    width: 220px;
                    height: 220px;
                    image-rendering: pixelated;
                }
            }

            SecondaryAction {
                width: 100%;
                text: Recovery.show-qr ? "Show words" : "Show as SeedQR";
                clicked => { Recovery.show-qr = !Recovery.show-qr; }
            }

            Text {
                text: "Write these down and keep them offline. Anyone who has them controls this seed's funds and can read its private notes.";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; }
        }

        // ------------------------------------- screen 23: PUBLIC keys
        // Watch-only exports for the active account: xpub + tr() descriptor
        // (whole account, all addresses). Safe to share.
        if Ui.screen == Screen.public-keys: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px + UISize.control-center-status-bar-height;
            padding-bottom: 24px;
            spacing: 12px;

            ScreenHeader {
                title: "Public keys";
                back => {
                    Callbacks.export-close();
                    Ui.screen = Screen.settings;
                }
            }

            Text {
                text: Recovery.export-title;
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 16px;
                font-weight: 600;
            }

            HorizontalLayout {
                spacing: 6px;
                PillOption {
                    label: "xpub";
                    selected: Recovery.export-which == 0;
                    horizontal-stretch: 1;
                    tapped => { Callbacks.export-select(0); }
                }
                PillOption {
                    label: "descriptor";
                    selected: Recovery.export-which == 1;
                    horizontal-stretch: 1;
                    tapped => { Callbacks.export-select(1); }
                }
            }

            Text {
                text: Recovery.export-label;
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                font-weight: 600;
            }
            Rectangle {
                background: Theme.palette-surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.palette-border;
                VerticalLayout {
                    padding: 12px;
                    Text {
                        text: Recovery.export-value;
                        color: Theme.palette-foreground;
                        font-family: "SourceCodePro";
                        font-size: 13px;
                        wrap: char-wrap;
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Image {
                    source: Recovery.export-qr;
                    width: 176px;
                    height: 176px;
                    image-rendering: pixelated;
                }
            }
            Text {
                text: "Import into any wallet to WATCH this account — see its balance and public notes across all addresses. It cannot spend or read private notes. The descriptor also tells the wallet the script type + key origin.";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 12px;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; }
        }

        // ------------------------------------- screen 24: PRIVATE keys
        // The dangerous exports: recovery words (whole seed) and a single
        // notebook's raw key (hex/WIF). Camera warning up top.
        if Ui.screen == Screen.private-keys: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px + UISize.control-center-status-bar-height;
            padding-bottom: 24px;
            spacing: 10px;

            ScreenHeader {
                title: "Private keys";
                back => {
                    Callbacks.export-close();
                    Ui.screen = Screen.settings;
                }
            }

            Text {
                text: Recovery.export-title;
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 16px;
                font-weight: 600;
            }
            Text {
                text: "Make sure no cameras or onlookers — anyone who captures these controls the coins and can read every private note.";
                color: Theme.palette-danger;
                font-family: "Montserrat";
                font-size: 12px;
                font-weight: 600;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 6px;
                PillOption {
                    label: "Seed words";
                    selected: Recovery.export-seed-view;
                    horizontal-stretch: 1;
                    tapped => {
                        Recovery.export-seed-view = true;
                        Recovery.show-qr = false;
                    }
                }
                PillOption {
                    label: "hex";
                    selected: !Recovery.export-seed-view && Recovery.export-which == 2;
                    horizontal-stretch: 1;
                    tapped => {
                        Recovery.export-seed-view = false;
                        Callbacks.export-select(2);
                    }
                }
                PillOption {
                    label: "WIF";
                    selected: !Recovery.export-seed-view && Recovery.export-which == 3;
                    horizontal-stretch: 1;
                    tapped => {
                        Recovery.export-seed-view = false;
                        Callbacks.export-select(3);
                    }
                }
            }

            // --- Seed-words view (whole seed) ---
            if Recovery.export-seed-view: VerticalLayout {
                spacing: 10px;
                Text {
                    text: "24 words · backs up the whole seed";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 13px;
                }
                if !Recovery.show-qr: HorizontalLayout {
                    spacing: 16px;
                    Text {
                        text: Recovery.words-col1;
                        color: Theme.palette-foreground;
                        font-family: "SourceCodePro";
                        font-size: 15px;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: Recovery.words-col2;
                        color: Theme.palette-foreground;
                        font-family: "SourceCodePro";
                        font-size: 15px;
                        horizontal-stretch: 1;
                    }
                }
                if Recovery.show-qr: HorizontalLayout {
                    alignment: center;
                    Image {
                        source: Recovery.qr;
                        width: 200px;
                        height: 200px;
                        image-rendering: pixelated;
                    }
                }
                SecondaryAction {
                    width: 100%;
                    text: Recovery.show-qr ? "Show words" : "Show as SeedQR";
                    clicked => { Recovery.show-qr = !Recovery.show-qr; }
                }
                Text {
                    text: "These 24 words back up the WHOLE seed — every account and notebook. Import them into any taproot wallet, or write them down offline.";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            // --- Single-key view (one notebook: hex/WIF) ---
            if !Recovery.export-seed-view: VerticalLayout {
                spacing: 10px;
                Text {
                    text: "Notebook (whose private key):";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 13px;
                }
                for nb in Recovery.export-notebooks: Rectangle {
                    height: 40px;
                    background: nb.index == Recovery.export-nb-index ? Theme.palette-primary : Theme.palette-surface;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: nb.index == Recovery.export-nb-index ? Theme.palette-primary : Theme.palette-border;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        Text {
                            text: nb.name;
                            color: nb.index == Recovery.export-nb-index ? #ffffff : Theme.palette-foreground;
                            font-family: "Montserrat";
                            font-size: 14px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: nb.addr;
                            color: nb.index == Recovery.export-nb-index ? #ffffff : Theme.palette-muted;
                            font-family: "SourceCodePro";
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea { clicked => { Callbacks.export-pick-notebook(nb.index); } }
                }
                Text {
                    text: Recovery.export-label;
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 13px;
                    font-weight: 600;
                }
                Rectangle {
                    background: Theme.palette-surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.palette-danger;
                    VerticalLayout {
                        padding: 12px;
                        Text {
                            text: Recovery.export-value;
                            color: Theme.palette-foreground;
                            font-family: "SourceCodePro";
                            font-size: 13px;
                            wrap: char-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: Recovery.export-qr;
                        width: 176px;
                        height: 176px;
                        image-rendering: pixelated;
                    }
                }
                Text {
                    text: "Just this one address's private key — import into the graffito desktop app or any wallet to spend it. The whole account recovers from the Seed words instead.";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            Rectangle { vertical-stretch: 1; }
        }

        // ---------------------------------- screen 25: Pay from (funding)
        // Two expandable coin lists — notebook (taproot) and spending
        // wallet (P2WPKH) — with independent per-coin selection. Selecting
        // coins from both sources at once is allowed (signed in one pass
        // via wpkh::sign_mixed_inputs) and flagged with a linkage warning.
        if Ui.screen == Screen.pay-from: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 8px + UISize.control-center-status-bar-height;
            padding-bottom: 24px;
            spacing: 10px;

            ScreenHeader {
                vertical-stretch: 0;
                title: "Pay from";
                back => { Callbacks.funding-done(); Ui.screen = Screen.compose; }
            }

            if Funding.warning != "": Text {
                vertical-stretch: 0;
                text: Funding.warning;
                color: Theme.palette-danger;
                font-family: "Montserrat";
                font-size: 13px;
                wrap: word-wrap;
            }

            Flickable {
                vertical-stretch: 1;
                viewport-width: self.width;
                viewport-height: 44px * 2 + 60px
                    + Funding.notebook-coins.length * 56px
                    + Funding.spending-coins.length * 56px;
                VerticalLayout {
                    spacing: 10px;
                    Rectangle {
                        height: 44px;
                        TouchArea { clicked => { Funding.notebook-expanded = !Funding.notebook-expanded; } }
                        HorizontalLayout {
                            Text {
                                text: "Notebook";
                                color: Theme.palette-foreground;
                                font-family: "Montserrat";
                                font-size: 16px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: Funding.notebook-summary + (Funding.notebook-expanded ? " ^" : " v");
                                color: Theme.palette-muted;
                                font-family: "Montserrat";
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if Funding.notebook-expanded: VerticalLayout {
                        spacing: 6px;
                        for c in Funding.notebook-coins: FundingCoinEntry {
                            entry: c;
                            tapped => { Callbacks.funding-toggle-coin(c.key); }
                        }
                        if Funding.notebook-coins.length == 0: Text {
                            text: "No spendable notebook coins.";
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 13px;
                        }
                    }
                    Rectangle {
                        height: 44px;
                        TouchArea { clicked => { Funding.spending-expanded = !Funding.spending-expanded; } }
                        HorizontalLayout {
                            Text {
                                text: "Spending wallet";
                                color: Theme.palette-foreground;
                                font-family: "Montserrat";
                                font-size: 16px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: Funding.spending-summary + (Funding.spending-expanded ? " ^" : " v");
                                color: Theme.palette-muted;
                                font-family: "Montserrat";
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if Funding.spending-expanded: VerticalLayout {
                        spacing: 6px;
                        for c in Funding.spending-coins: FundingCoinEntry {
                            entry: c;
                            tapped => { Callbacks.funding-toggle-coin(c.key); }
                        }
                        if Funding.spending-coins.length == 0: Text {
                            text: Funding.spending-enabled
                                ? "No spending-wallet coins yet — fund its address and import a sync bundle."
                                : "Off — turn on \"Separate spending wallet\" in Settings first.";
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // -------------------------------------------- screen 26: Change
        // Single-select destination for the compose in progress.
        if Ui.screen == Screen.change: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 8px + UISize.control-center-status-bar-height;
            padding-bottom: 24px;
            spacing: 10px;

            ScreenHeader {
                vertical-stretch: 0;
                title: "Change";
                back => { Callbacks.change-done(); Ui.screen = Screen.compose; }
            }

            ChangeOptionRow {
                vertical-stretch: 0;
                option-label: "Auto";
                sub: ChangePick.auto-label;
                selected: ChangePick.choice == "auto";
                tapped => { Callbacks.change-pick("auto"); }
            }
            ChangeOptionRow {
                vertical-stretch: 0;
                option-label: "Notebook address";
                sub: "Change returns to your notebook — the same address it goes to today.";
                selected: ChangePick.choice == "notebook";
                tapped => { Callbacks.change-pick("notebook"); }
            }
            ChangeOptionRow {
                vertical-stretch: 0;
                option-label: "Custom address…";
                sub: "";
                selected: ChangePick.choice == "custom";
                tapped => { Callbacks.change-pick("custom"); }
            }
            if ChangePick.choice == "custom": VerticalLayout {
                vertical-stretch: 0;
                spacing: 6px;
                Text {
                    text: ChangePick.custom-error == "" ? "Change address" : ChangePick.custom-error;
                    color: ChangePick.custom-error == "" ? Theme.palette-muted : Theme.palette-danger;
                    font-family: "Montserrat";
                    font-size: 13px;
                }
                Rectangle {
                    height: 44px;
                    background: Theme.palette-surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: change-addr-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                    clip: true;
                    change-addr-input := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        height: 24px;
                        y: (parent.height - self.height) / 2;
                        text <=> ChangePick.custom-address;
                        color: Theme.palette-foreground;
                        font-family: "SourceCodePro";
                        font-size: 16px;
                        single-line: true;
                        edited => { Callbacks.change-address-changed(); }
                        accepted => { self.clear-focus(); }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }

        // --------------------------------- screen 27: Quantum keys (pq.rs)
        // This notebook's post-quantum (ML-KEM) receive identity: level
        // picker, fingerprint, and a scannable QR of the armored public
        // key for a contact to import. Public-key export only — the 24
        // recovery words (Settings → "Recovery words…") already
        // reconstruct every derived key, so no separate private-key
        // export lives here.
        if Ui.screen == Screen.quantum-keys: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px + UISize.control-center-status-bar-height;
            padding-bottom: 24px;
            spacing: 12px;

            ScreenHeader {
                title: "Quantum keys";
                back => { Callbacks.quantum-keys-close(); Ui.screen = Screen.settings; }
            }

            Text {
                text: "This notebook's ML-KEM receive key — derived from your seed, same on every device restored from it. Share the QR with a contact so they can send you quantum-resistant directed notes.";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                wrap: word-wrap;
            }

            // Notebook picker — same row design + selection convention as
            // the Export-keys screen's "Notebook (whose private key)"
            // picker (screen 23/24, `Recovery.export-notebooks` /
            // `export-pick-notebook`), reusing the shared `ExportNbRow`
            // struct. Each notebook has its own ML-KEM keypair (derived
            // from its own BIP-86 leaf secret), so switching here must
            // re-derive the fingerprint + QR for the newly picked notebook.
            Text {
                text: "Notebook:";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                font-weight: 600;
            }
            VerticalLayout {
                spacing: 6px;
                for nb in QuantumKeys.notebooks: Rectangle {
                    height: 40px;
                    background: nb.index == QuantumKeys.nb-index ? Theme.palette-primary : Theme.palette-surface;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: nb.index == QuantumKeys.nb-index ? Theme.palette-primary : Theme.palette-border;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        Text {
                            text: nb.name;
                            color: nb.index == QuantumKeys.nb-index ? #ffffff : Theme.palette-foreground;
                            font-family: "Montserrat";
                            font-size: 14px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: nb.addr;
                            color: nb.index == QuantumKeys.nb-index ? #ffffff : Theme.palette-muted;
                            font-family: "SourceCodePro";
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea { clicked => { Callbacks.quantum-key-pick-notebook(nb.index); } }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                PillOption {
                    label: "512";
                    selected: QuantumKeys.level == 0;
                    horizontal-stretch: 1;
                    tapped => { Callbacks.quantum-key-level(0); }
                }
                PillOption {
                    label: "768";
                    selected: QuantumKeys.level == 1;
                    horizontal-stretch: 1;
                    tapped => { Callbacks.quantum-key-level(1); }
                }
                PillOption {
                    label: "1024";
                    selected: QuantumKeys.level == 2;
                    horizontal-stretch: 1;
                    tapped => { Callbacks.quantum-key-level(2); }
                }
            }
            Text {
                text: QuantumKeys.level-caption;
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 12px;
                wrap: word-wrap;
            }

            Text {
                text: "Fingerprint";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                font-weight: 600;
            }
            Rectangle {
                background: Theme.palette-surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.palette-border;
                VerticalLayout {
                    padding: 12px;
                    Text {
                        text: QuantumKeys.fingerprint;
                        color: Theme.palette-foreground;
                        font-family: "SourceCodePro";
                        font-size: 15px;
                        wrap: char-wrap;
                    }
                }
            }

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 176px;
                    height: 176px;
                    Image {
                        source: QuantumKeys.public-qr;
                        width: 176px;
                        height: 176px;
                        image-rendering: pixelated;
                    }
                    // LAST child so the tap isn't swallowed by the Image
                    // (slint: later sibling wins input — qr-zoom memory).
                    TouchArea {
                        clicked => {
                            QuantumKeys.qr-zoom = true;
                            Callbacks.quantum-qr-zoom(true);
                        }
                    }
                }
            }
            // Legibility note: an armored ML-KEM public key is ~1.7 KB,
            // rendered as one dense QR (no animated-UR encoder is wired
            // in this app — the device only ever DECODES animated UR via
            // the system scanner, e.g. for sync bundles; encoding one
            // would need a different, not readily-reusable payload
            // framing). A phone camera can still read a dense code, but
            // it wants a steady hand and good light.
            Text {
                text: "Dense QR — hold steady and well-lit, or scan with the companion / graffito desktop app, which also accepts this key by file or paste.";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 12px;
                wrap: word-wrap;
            }
            Text {
                text: "This is your PUBLIC key — safe to share. Your device backup is the 24 recovery words (Settings → \"Recovery words…\"), which reconstruct this key too.";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 12px;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; }
        }

        // Fullscreen armor-QR overlay (screen 27's tap-to-zoom) — a LATER
        // SIBLING of the screen layout so it paints on top; white ground
        // so the code has maximum contrast, QR at the largest square that
        // fits. Tap anywhere closes (dismiss TouchArea is the LAST child —
        // the qr-zoom rule: anything stacked above it swallows the tap).
        if Ui.screen == Screen.quantum-keys && QuantumKeys.qr-zoom: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #ffffff;
            Image {
                source: QuantumKeys.public-qr;
                width: min(parent.width, parent.height) - 24px;
                height: self.width;
                image-rendering: pixelated;
            }
            TouchArea {
                clicked => {
                    QuantumKeys.qr-zoom = false;
                    Callbacks.quantum-qr-zoom(false);
                }
            }
        }

        // -------------------------------- screen 28: my quantum key
        // PLAN-graffito-quantum-key.md: a single, NON-seed-derived
        // personal ML-KEM keypair — generate-or-import while none exists,
        // else fingerprint + share/export/replace/delete. `DeviceQuantumKey
        // .view` picks which panel of the "key present" state shows.
        if Ui.screen == Screen.device-quantum-key: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px + UISize.control-center-status-bar-height;
            padding-bottom: 0;
            spacing: 12px;

            ScreenHeader {
                title: "My quantum key";
                back => { Callbacks.device-quantum-key-close(); Ui.screen = Screen.settings; }
            }

            Flickable {
                vertical-stretch: 1;
                viewport-width: self.width;
                viewport-height: dqk-content.preferred-height;
                dqk-content := VerticalLayout {
                    spacing: 12px;
                    padding-bottom: 24px;

                    // ---- No key yet: generate or import ----
                    if !DeviceQuantumKey.has-key: VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "A personal quantum key, separate from your seed. It is NOT recovered by your 24 recovery words, and it dies if this app is ever uninstalled — losing it loses every note sealed to it. Export a backup once you've created one.";
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Level:";
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 13px;
                            font-weight: 600;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            PillOption {
                                label: "512";
                                selected: DeviceQuantumKey.gen-level == 0;
                                horizontal-stretch: 1;
                                tapped => { Callbacks.device-quantum-key-gen-level(0); }
                            }
                            PillOption {
                                label: "768";
                                selected: DeviceQuantumKey.gen-level == 1;
                                horizontal-stretch: 1;
                                tapped => { Callbacks.device-quantum-key-gen-level(1); }
                            }
                            PillOption {
                                label: "1024";
                                selected: DeviceQuantumKey.gen-level == 2;
                                horizontal-stretch: 1;
                                tapped => { Callbacks.device-quantum-key-gen-level(2); }
                            }
                        }
                        Text {
                            text: (DeviceQuantumKey.gen-level == 1 ? "Recommended. " : "") + DeviceQuantumKey.gen-level-caption;
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Optional: type anything — a passphrase, dice rolls. Mixed WITH the device's hardware randomness; it can only add strength, never replace it.";
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 44px;
                            background: Theme.palette-surface;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: dqk-extra-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                            clip: true;
                            dqk-extra-input := TextInput {
                                x: 14px;
                                width: parent.width - 28px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                text <=> DeviceQuantumKey.gen-extra-text;
                                color: Theme.palette-foreground;
                                font-family: "SourceCodePro";
                                font-size: 16px;
                                single-line: true;
                                accepted => { self.clear-focus(); }
                            }
                        }

                        if DeviceQuantumKey.gen-error != "": Text {
                            text: DeviceQuantumKey.gen-error;
                            color: Theme.palette-danger;
                            font-family: "Montserrat";
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        PrimaryAction {
                            width: 100%;
                            text: "Generate";
                            clicked => { Callbacks.device-quantum-key-generate(); }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.palette-border;
                        }

                        SecondaryAction {
                            width: 100%;
                            text: "Import…";
                            clicked => { Callbacks.device-quantum-key-import(); }
                        }
                        Text {
                            text: "From a backup, another device's export, or the graffito Mac app — the PRIVATE key armor, not the public one.";
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if DeviceQuantumKey.import-error != "": Text {
                            text: DeviceQuantumKey.import-error;
                            color: Theme.palette-danger;
                            font-family: "Montserrat";
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    // ---- Key present: summary + actions ----
                    if DeviceQuantumKey.has-key && DeviceQuantumKey.view == "": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "Fingerprint";
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 13px;
                            font-weight: 600;
                        }
                        Rectangle {
                            background: Theme.palette-surface;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.palette-border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text {
                                    text: DeviceQuantumKey.level-name;
                                    color: Theme.palette-muted;
                                    font-family: "Montserrat";
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: DeviceQuantumKey.fingerprint;
                                    color: Theme.palette-foreground;
                                    font-family: "SourceCodePro";
                                    font-size: 15px;
                                    wrap: char-wrap;
                                }
                            }
                        }

                        SecondaryAction {
                            width: 100%;
                            text: "Share public key";
                            clicked => { DeviceQuantumKey.view = "public"; }
                        }
                        SecondaryAction {
                            width: 100%;
                            text: "Export private key…";
                            clicked => { DeviceQuantumKey.view = "private-warn"; }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.palette-danger;
                        }
                        Text {
                            text: "Dangerous area";
                            color: Theme.palette-danger;
                            font-family: "Montserrat";
                            font-size: 13px;
                            font-weight: 700;
                        }
                        SecondaryAction {
                            width: 100%;
                            text: "Replace…";
                            clicked => { DeviceQuantumKey.show-replace-confirm = true; }
                        }
                        SecondaryAction {
                            width: 100%;
                            text: "Delete…";
                            clicked => { DeviceQuantumKey.show-delete-confirm = true; }
                        }
                    }

                    // ---- Share public key (safe, no warning) ----
                    if DeviceQuantumKey.has-key && DeviceQuantumKey.view == "public": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "Safe to share — anyone can seal a note to this key, but never decrypt one. Scan it into the graffito Mac app to mirror the same key there.";
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 176px;
                                height: 176px;
                                Image {
                                    source: DeviceQuantumKey.public-qr;
                                    width: 176px;
                                    height: 176px;
                                    image-rendering: pixelated;
                                }
                                TouchArea {
                                    clicked => {
                                        DeviceQuantumKey.qr-zoom = true;
                                        Callbacks.device-quantum-key-qr-zoom(true);
                                    }
                                }
                            }
                        }
                        Text {
                            text: "Dense QR — tap to fill the screen, hold steady and well-lit.";
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        SecondaryAction {
                            width: 100%;
                            text: "Close";
                            clicked => { DeviceQuantumKey.view = ""; }
                        }
                    }

                    // ---- Export private key: warning step ----
                    if DeviceQuantumKey.has-key && DeviceQuantumKey.view == "private-warn": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "Anyone who scans this can read every note sealed to this quantum key — treat it like a private key, because it is one. Use this only to back it up, or to mirror the same key onto the graffito Mac app.";
                            color: Theme.palette-foreground;
                            font-family: "Montserrat";
                            font-size: 14px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            SecondaryAction {
                                horizontal-stretch: 1;
                                text: "Cancel";
                                clicked => { DeviceQuantumKey.view = ""; }
                            }
                            PrimaryAction {
                                horizontal-stretch: 1;
                                text: "I understand — show it";
                                clicked => { Callbacks.device-quantum-key-reveal-private(); }
                            }
                        }
                    }

                    // ---- Export private key: revealed ----
                    if DeviceQuantumKey.has-key && DeviceQuantumKey.view == "private": VerticalLayout {
                        spacing: 12px;
                        if DeviceQuantumKey.private-fits-qr: HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 176px;
                                height: 176px;
                                Image {
                                    source: DeviceQuantumKey.private-qr;
                                    width: 176px;
                                    height: 176px;
                                    image-rendering: pixelated;
                                }
                                TouchArea {
                                    clicked => {
                                        DeviceQuantumKey.qr-zoom = true;
                                        Callbacks.device-quantum-key-qr-zoom(true);
                                    }
                                }
                            }
                        }
                        if !DeviceQuantumKey.private-fits-qr: Text {
                            text: "Too large for one QR — copy the text below instead.";
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            background: Theme.palette-surface;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.palette-border;
                            VerticalLayout {
                                padding: 12px;
                                Text {
                                    text: DeviceQuantumKey.private-armor;
                                    color: Theme.palette-foreground;
                                    font-family: "SourceCodePro";
                                    font-size: 12px;
                                    wrap: char-wrap;
                                }
                            }
                        }
                        SecondaryAction {
                            width: 100%;
                            text: "Close";
                            clicked => { Callbacks.device-quantum-key-hide-private(); }
                        }
                    }
                }
            }
        }

        // Fullscreen armor-QR overlay (screen 28's tap-to-zoom) — mirrors
        // screen 27's; picks the public or private QR by which panel is
        // showing.
        if Ui.screen == Screen.device-quantum-key && DeviceQuantumKey.qr-zoom: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #ffffff;
            Image {
                source: DeviceQuantumKey.view == "private" ? DeviceQuantumKey.private-qr : DeviceQuantumKey.public-qr;
                width: min(parent.width, parent.height) - 24px;
                height: self.width;
                image-rendering: pixelated;
            }
            TouchArea {
                clicked => {
                    DeviceQuantumKey.qr-zoom = false;
                    Callbacks.device-quantum-key-qr-zoom(false);
                }
            }
        }

        // ------------------------------------ screen 7: contacts (send-to)
        // The one input slot doubles as manual address entry and, when a
        // row's "name" zone was tapped, the contact-name editor. Errors go
        // in the label above the field so the keyboard can't hide them.
        if Ui.screen == Screen.contacts: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px + UISize.control-center-status-bar-height;
            padding-bottom: 24px;
            spacing: 10px;

            ScreenHeader {
                vertical-stretch: 0;
                title: Contacts.pick-mode == "sweep" ? "Sweep to" : "Send to";
                back => {
                    if Contacts.pick-mode == "sweep" {
                        Contacts.pick-mode = "compose";
                        Ui.screen = Screen.settings;
                    } else {
                        Callbacks.refresh-home();
                        Ui.screen = Screen.home;
                    }
                }
            }

            Text {
                vertical-stretch: 0;
                height: 18px;
                text: Contacts.input-error != "" ? Contacts.input-error
                    : Contacts.pick-mode == "sweep" ? "Destination address" : "Recipient address";
                color: Contacts.input-error != "" ? Theme.palette-danger : Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 14px;
                overflow: elide;
            }
            HorizontalLayout {
                vertical-stretch: 0;
                height: 44px;
                spacing: 8px;
                Rectangle {
                    height: 44px;
                    horizontal-stretch: 1;
                    background: Theme.palette-surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: contact-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                    clip: true;
                    contact-input := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        height: 24px;
                        y: (parent.height - self.height) / 2;
                        text <=> Contacts.input-text;
                        color: Theme.palette-foreground;
                        font-family: "SourceCodePro";
                        font-size: 15px;
                        single-line: true;
                        edited => { Contacts.input-error = ""; }
                        // Keyboard "Done" blurs → KeyOS hides the keyboard.
                        accepted => { self.clear-focus(); }
                    }
                    Text {
                        x: 14px;
                        height: parent.height;
                        text: Contacts.input-text == "" && contact-input.preedit-text == ""
                            ? "Paste or type an address…" : "";
                        color: Theme.palette-muted;
                        font-family: "SourceCodePro";
                        font-size: 15px;
                        vertical-alignment: center;
                    }
                }
                // Fixed width so the address field gets the room.
                PillOption {
                    width: 72px;
                    label: "Use";
                    selected: true;
                    tapped => { Callbacks.pick-contact(Contacts.input-text); }
                }
            }

            // First and handiest option: the classic self-notebook note.
            // Hidden in sweep mode — sweep-to-self is the Coins screen's
            // consolidate, not a picker choice.
            if Contacts.pick-mode != "sweep": Rectangle {
                vertical-stretch: 0;
                height: 56px;
                border-radius: 12px;
                background: self-touch.has-hover ? Theme.palette-surface : transparent;
                border-width: 1px;
                border-color: Theme.palette-primary;
                self-touch := TouchArea { clicked => { Callbacks.pick-contact(""); } }
                VerticalLayout {
                    padding: 10px;
                    spacing: 2px;
                    Text {
                        text: "To: Self";
                        color: Theme.palette-foreground;
                        font-family: "Montserrat";
                        font-size: 18px;
                        font-weight: 600;
                    }
                    Text {
                        text: "my notebook — this device's own address";
                        color: Theme.palette-muted;
                        font-family: "Montserrat";
                        font-size: 13px;
                    }
                }
            }

            SecondaryAction {
                vertical-stretch: 0;
                height: 52px;
                width: 100%;
                text: "Scan address QR";
                clicked => { Callbacks.scan-contact(); }
            }

            Text {
                vertical-stretch: 0;
                height: 16px;
                text: Contacts.rows.length > 0 ? "Recent"
                    : "Addresses you send to appear here.";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
            }

            Flickable {
                vertical-stretch: 1;
                viewport-height: Contacts.rows.length * 72px;
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    for entry in Contacts.rows: ContactEntry {
                        entry: entry;
                        tapped => { Callbacks.pick-contact(entry.address); }
                        rename => {
                            Contacts.naming-address = entry.address;
                            Contacts.name-text = entry.name;
                            Contacts.naming-label = "Name for " + entry.meta;
                            Contacts.naming-pq-caption = entry.pq-caption;
                            Contacts.naming-pq-error = "";
                        }
                    }
                }
            }
        }

        // Naming dialog — modal over the contacts screen. Anchored near
        // the TOP so the on-screen keyboard never covers it; nested inside
        // the root container (sibling-app gotcha).
        // ------------------------------------ screen 20: notebooks (MAIN)
        // A notebook = an indexed identity; tapping a row opens its home
        // (screen 0). Boot lands here. Fresh install = empty list.
        if Ui.screen == Screen.notebooks: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 24px + UISize.control-center-status-bar-height;
            padding-bottom: 24px;
            spacing: 14px;

            Text {
                text: "Graffito";
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 26px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            PrimaryAction {
                width: 100%;
                text: "+  New notebook";
                clicked => { NotebookCb.create(); }
            }
            SecondaryAction {
                width: 100%;
                text: "Settings";
                clicked => { Callbacks.refresh-home(); Callbacks.funding-open(); Ui.screen = Screen.settings; }
            }

            if Ui.error != "": Text {
                text: Ui.error;
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }

            if NotebooksUi.empty-line != "": Text {
                text: NotebooksUi.empty-line;
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 15px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }

            Flickable {
                vertical-stretch: 1;
                viewport-height: NotebooksUi.rows.length * 92px
                    + (NotebooksUi.archived-label != "" ? 44px : 0px)
                    + (NotebooksUi.show-archived ? NotebooksUi.archived-rows.length * 72px : 0px);
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    for nb in NotebooksUi.rows: Rectangle {
                        height: 84px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: nb.active ? Theme.palette-primary : Theme.palette-border;
                        TouchArea { clicked => { NotebookCb.open(nb.account); } }
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                alignment: center;
                                Text {
                                    text: nb.name;
                                    color: Theme.palette-foreground;
                                    font-family: "Montserrat";
                                    font-size: 18px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: nb.meta;
                                    color: Theme.palette-muted;
                                    font-family: "SourceCodePro";
                                    font-size: 13px;
                                    overflow: elide;
                                }
                            }
                            // Rename
                            Rectangle {
                                width: 40px;
                                TouchArea { clicked => { NotebookCb.rename(nb.account); } }
                                Text {
                                    text: "Aa";
                                    color: Theme.palette-muted;
                                    font-family: "Montserrat";
                                    font-size: 15px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            // Archive
                            Rectangle {
                                width: 40px;
                                TouchArea { clicked => { NotebookCb.archive(nb.account, true); } }
                                Text {
                                    text: "×";
                                    color: Theme.palette-muted;
                                    font-family: "Montserrat";
                                    font-size: 22px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                    if NotebooksUi.archived-label != "": Rectangle {
                        height: 36px;
                        TouchArea { clicked => { NotebooksUi.show-archived = !NotebooksUi.show-archived; } }
                        Text {
                            text: NotebooksUi.archived-label + (NotebooksUi.show-archived ? "  ^" : "  v");
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 14px;
                            x: 4px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    if NotebooksUi.show-archived: VerticalLayout {
                        spacing: 8px;
                        for nb in NotebooksUi.archived-rows: Rectangle {
                            height: 64px;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.palette-border;
                            HorizontalLayout {
                                padding: 12px;
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: nb.name;
                                        color: Theme.palette-muted;
                                        font-family: "Montserrat";
                                        font-size: 15px;
                                        overflow: elide;
                                    }
                                }
                                SecondaryAction {
                                    text: "Restore";
                                    clicked => { NotebookCb.archive(nb.account, false); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- notebook name dialog (create + rename) ----
        if NotebooksUi.name-account != -1: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000088;
            TouchArea { }   // swallow taps outside the panel
            Rectangle {
                x: 24px;
                y: 90px + UISize.control-center-status-bar-height;
                width: parent.width - 48px;
                height: 176px;
                background: Theme.palette-surface;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.palette-border;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        height: 20px;
                        text: NotebooksUi.name-account == -2 ? "Name your new notebook" : "Name this notebook";
                        color: Theme.palette-foreground;
                        font-family: "Montserrat";
                        font-size: 16px;
                        font-weight: 600;
                    }
                    Rectangle {
                        height: 44px;
                        background: Theme.palette-background;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: nb-name-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                        clip: true;
                        nb-name-input := TextInput {
                            x: 14px;
                            width: parent.width - 28px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            text <=> NotebooksUi.name-text;
                            color: Theme.palette-foreground;
                            font-family: "Montserrat";
                            font-size: 16px;
                            single-line: true;
                            accepted => { self.clear-focus(); }
                        }
                        Text {
                            x: 14px;
                            height: parent.height;
                            text: NotebooksUi.name-text == "" && nb-name-input.preedit-text == ""
                                ? "Name (optional)" : "";
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 15px;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        height: 48px;
                        spacing: 8px;
                        SecondaryAction {
                            horizontal-stretch: 1;
                            font-size: 16px;          // 48px row: default 20px+12px padding elides (2026-08-22)
                            padding-vertical: 6px;
                            text: "Cancel";
                            clicked => {
                                nb-name-input.clear-focus();
                                NotebookCb.name-cancel();
                            }
                        }
                        PrimaryAction {
                            horizontal-stretch: 1;
                            font-size: 16px;          // 48px row: default 20px+12px padding elides (2026-08-22)
                            padding-vertical: 6px;
                            text: NotebooksUi.name-account == -2 ? "Create" : "Save";
                            clicked => {
                                nb-name-input.clear-focus();
                                NotebookCb.name-save();
                            }
                        }
                    }
                }
            }
        }

        if Contacts.naming-address != "": Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000088;
            TouchArea { }   // swallow taps outside the panel
            Rectangle {
                x: 24px;
                y: 90px + UISize.control-center-status-bar-height;
                width: parent.width - 48px;
                height: 254px;
                background: Theme.palette-surface;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.palette-border;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        height: 20px;
                        text: Contacts.naming-label;
                        color: Theme.palette-foreground;
                        font-family: "Montserrat";
                        font-size: 16px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Rectangle {
                        height: 44px;
                        background: Theme.palette-background;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: name-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                        clip: true;
                        name-input := TextInput {
                            x: 14px;
                            width: parent.width - 28px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            text <=> Contacts.name-text;
                            color: Theme.palette-foreground;
                            font-family: "Montserrat";
                            font-size: 16px;
                            single-line: true;
                            // Keyboard "Done" blurs → keyboard hides.
                            accepted => { self.clear-focus(); }
                        }
                        Text {
                            x: 14px;
                            height: parent.height;
                            text: Contacts.name-text == "" && name-input.preedit-text == ""
                                ? "Contact name (empty to clear)" : "";
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 15px;
                            vertical-alignment: center;
                        }
                    }
                    // Quantum key (pq.rs): scan an armored ML-KEM public
                    // key for this contact — enables the ML-KEM layer on
                    // directed private notes addressed to them.
                    Text {
                        height: 16px;
                        text: Contacts.naming-pq-error != "" ? Contacts.naming-pq-error
                            : Contacts.naming-pq-caption != "" ? Contacts.naming-pq-caption
                            : "No quantum key on file";
                        color: Contacts.naming-pq-error != "" ? Theme.palette-danger : Theme.palette-muted;
                        font-family: "SourceCodePro";
                        font-size: 12px;
                        overflow: elide;
                    }
                    SecondaryAction {
                        height: 40px;
                        width: 100%;
                        // 40px tall: the component's 20px font + 12px
                        // vertical padding elide the label to NOTHING —
                        // shrink both (the pre-pq naming dialog had the
                        // same blank-button bug; 2026-08-22).
                        font-size: 15px;
                        padding-vertical: 6px;
                        text: "Scan quantum key";
                        clicked => { Callbacks.scan-contact-pq(); }
                    }
                    HorizontalLayout {
                        height: 48px;
                        spacing: 8px;
                        SecondaryAction {
                            horizontal-stretch: 1;
                            font-size: 16px;          // 48px row: default 20px+12px padding elides (2026-08-22)
                            padding-vertical: 6px;
                            text: "Cancel";
                            clicked => {
                                Contacts.naming-address = "";
                                Contacts.name-text = "";
                                Contacts.naming-pq-caption = "";
                                Contacts.naming-pq-error = "";
                            }
                        }
                        PrimaryAction {
                            horizontal-stretch: 1;
                            font-size: 16px;
                            padding-vertical: 6px;
                            text: "Save";
                            clicked => {
                                name-input.clear-focus();
                                Callbacks.save-contact-name();
                            }
                        }
                    }
                }
            }
        }

        // Note-too-large dialog — nested in root (sibling-app overlay gotcha).
        if Compose.show-oversize: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000088;
            TouchArea { }   // swallow taps outside the panel
            Rectangle {
                x: 24px;
                y: 90px + UISize.control-center-status-bar-height;
                width: parent.width - 48px;
                height: oversize-panel.preferred-height;
                background: Theme.palette-surface;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.palette-border;
                oversize-panel := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: "Note too large";
                        color: Theme.palette-foreground;
                        font-family: "Montserrat";
                        font-size: 16px;
                        font-weight: 600;
                    }
                    Text {
                        text: Compose.oversize-message;
                        color: Theme.palette-muted;
                        font-family: "Montserrat";
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        SecondaryAction {
                            horizontal-stretch: 1;
                            text: Compose.oversize-offer-bump ? "Cancel" : "OK";
                            clicked => { Compose.show-oversize = false; }
                        }
                        if Compose.oversize-offer-bump: PrimaryAction {
                            horizontal-stretch: 1;
                            text: "Switch to Standard";
                            clicked => { Callbacks.oversize-bump(); }
                        }
                    }
                }
            }
        }

        // Quantum-key Replace confirm — nested in root (sibling-app
        // overlay gotcha, same as the oversize dialog above).
        if DeviceQuantumKey.show-replace-confirm: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000088;
            TouchArea { }
            Rectangle {
                x: 24px;
                y: 90px + UISize.control-center-status-bar-height;
                width: parent.width - 48px;
                height: dqk-replace-panel.preferred-height;
                background: Theme.palette-surface;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.palette-border;
                dqk-replace-panel := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: "Replace this quantum key?";
                        color: Theme.palette-foreground;
                        font-family: "Montserrat";
                        font-size: 16px;
                        font-weight: 600;
                    }
                    Text {
                        text: "Notes sealed to the CURRENT key become permanently unreadable unless you already exported it. This can't be undone.";
                        color: Theme.palette-danger;
                        font-family: "Montserrat";
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        SecondaryAction {
                            horizontal-stretch: 1;
                            text: "Cancel";
                            clicked => { DeviceQuantumKey.show-replace-confirm = false; }
                        }
                        PrimaryAction {
                            horizontal-stretch: 1;
                            text: "Replace";
                            clicked => { Callbacks.device-quantum-key-replace-confirm(); }
                        }
                    }
                }
            }
        }

        // Quantum-key Delete confirm.
        if DeviceQuantumKey.show-delete-confirm: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000088;
            TouchArea { }
            Rectangle {
                x: 24px;
                y: 90px + UISize.control-center-status-bar-height;
                width: parent.width - 48px;
                height: dqk-delete-panel.preferred-height;
                background: Theme.palette-surface;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.palette-border;
                dqk-delete-panel := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: "Delete this quantum key?";
                        color: Theme.palette-foreground;
                        font-family: "Montserrat";
                        font-size: 16px;
                        font-weight: 600;
                    }
                    Text {
                        text: "Notes sealed to it become permanently unreadable unless you already exported it. This can't be undone.";
                        color: Theme.palette-danger;
                        font-family: "Montserrat";
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        SecondaryAction {
                            horizontal-stretch: 1;
                            text: "Cancel";
                            clicked => { DeviceQuantumKey.show-delete-confirm = false; }
                        }
                        PrimaryAction {
                            horizontal-stretch: 1;
                            text: "Delete";
                            clicked => { Callbacks.device-quantum-key-delete-confirm(); }
                        }
                    }
                }
            }
        }

        // Busy overlay — nested inside the root container (never a direct
        // Window child; sibling-app gotcha).
        if Ui.busy: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000088;
            TouchArea { }
            Rectangle {
                width: 220px;
                height: 80px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Theme.palette-surface;
                border-radius: 16px;
                Text {
                    text: "Working…";
                    color: Theme.palette-foreground;
                    font-family: "Montserrat";
                    font-size: 20px;
                    font-weight: 600;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }
}
