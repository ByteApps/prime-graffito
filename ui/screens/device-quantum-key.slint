// Screen.device-quantum-key — extracted verbatim from app.slint on 2026-09-01
// (PLAN-graffito-arch.md phase 4a). The instantiation site in app.slint
// still sets width/height to the window; everything else is the
// original block body.
// -------------------------------- screen 28: my quantum key
// PLAN-graffito-quantum-key.md: a single, NON-seed-derived
// personal ML-KEM keypair — generate-or-import while none exists,
// else fingerprint + share/export/replace/delete. `DeviceQuantumKey
// .view` picks which panel of the "key present" state shows.

import { Theme, UISize } from "@ui/theme.slint";
import { Screen, Callbacks, Ui, DeviceQuantumKey } from "../callbacks.slint";
import { PrimaryAction, SecondaryAction, ScreenHeader, PillOption, LevelPills, MonoCard } from "../components.slint";

export component DeviceQuantumKeyScreen inherits VerticalLayout {
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 16px + UISize.control-center-status-bar-height;
    padding-bottom: 0;
    spacing: 12px;

    ScreenHeader {
        title: "My quantum key";
        back => { Callbacks.device-quantum-key-close(); Ui.screen = Screen.settings; }
    }

    Flickable {
        vertical-stretch: 1;
        viewport-width: self.width;
        viewport-height: dqk-content.preferred-height;
        dqk-content := VerticalLayout {
            spacing: 12px;
            padding-bottom: 24px;

            // ---- No key yet: generate or import ----
            if !DeviceQuantumKey.has-key: VerticalLayout {
                spacing: 12px;
                Text {
                    text: "A personal quantum key, separate from your seed. It is NOT recovered by your 24 recovery words, and it dies if this app is ever uninstalled — losing it loses every note sealed to it. Export a backup once you've created one.";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Text {
                    text: "Level:";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 13px;
                    font-weight: 600;
                }
                LevelPills {
                    level: DeviceQuantumKey.gen-level;
                    pick(i) => { Callbacks.device-quantum-key-gen-level(i); }
                }
                Text {
                    text: (DeviceQuantumKey.gen-level == 1 ? "Recommended. " : "") + DeviceQuantumKey.gen-level-caption;
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Text {
                    text: "Optional: type anything — a passphrase, dice rolls. Mixed WITH the device's hardware randomness; it can only add strength, never replace it.";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 44px;
                    background: Theme.palette-surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: dqk-extra-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                    clip: true;
                    dqk-extra-input := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        height: 24px;
                        y: (parent.height - self.height) / 2;
                        text <=> DeviceQuantumKey.gen-extra-text;
                        color: Theme.palette-foreground;
                        font-family: "SourceCodePro";
                        font-size: 16px;
                        single-line: true;
                        accepted => { self.clear-focus(); }
                    }
                }

                if DeviceQuantumKey.gen-error != "": Text {
                    text: DeviceQuantumKey.gen-error;
                    color: Theme.palette-danger;
                    font-family: "Montserrat";
                    font-size: 13px;
                    wrap: word-wrap;
                }

                PrimaryAction {
                    width: 100%;
                    text: "Generate";
                    clicked => { Callbacks.device-quantum-key-generate(); }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.palette-border;
                }

                SecondaryAction {
                    width: 100%;
                    text: "Import…";
                    clicked => { Callbacks.device-quantum-key-import(); }
                }
                Text {
                    text: "From a backup, another device's export, or the graffito Mac app — the PRIVATE key armor, not the public one.";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if DeviceQuantumKey.import-error != "": Text {
                    text: DeviceQuantumKey.import-error;
                    color: Theme.palette-danger;
                    font-family: "Montserrat";
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }

            // ---- Key present: summary + actions ----
            if DeviceQuantumKey.has-key && DeviceQuantumKey.view == "": VerticalLayout {
                spacing: 12px;
                Text {
                    text: "Fingerprint";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 13px;
                    font-weight: 600;
                }
                Rectangle {
                    background: Theme.palette-surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.palette-border;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        Text {
                            text: DeviceQuantumKey.level-name;
                            color: Theme.palette-muted;
                            font-family: "Montserrat";
                            font-size: 12px;
                            font-weight: 600;
                        }
                        Text {
                            text: DeviceQuantumKey.fingerprint;
                            color: Theme.palette-foreground;
                            font-family: "SourceCodePro";
                            font-size: 15px;
                            wrap: char-wrap;
                        }
                    }
                }

                SecondaryAction {
                    width: 100%;
                    text: "Share public key";
                    clicked => { DeviceQuantumKey.view = "public"; }
                }
                SecondaryAction {
                    width: 100%;
                    text: "Export private key…";
                    clicked => { DeviceQuantumKey.view = "private-warn"; }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.palette-danger;
                }
                Text {
                    text: "Dangerous area";
                    color: Theme.palette-danger;
                    font-family: "Montserrat";
                    font-size: 13px;
                    font-weight: 700;
                }
                SecondaryAction {
                    width: 100%;
                    text: "Replace…";
                    clicked => { DeviceQuantumKey.show-replace-confirm = true; }
                }
                SecondaryAction {
                    width: 100%;
                    text: "Delete…";
                    clicked => { DeviceQuantumKey.show-delete-confirm = true; }
                }
            }

            // ---- Share public key (safe, no warning) ----
            if DeviceQuantumKey.has-key && DeviceQuantumKey.view == "public": VerticalLayout {
                spacing: 12px;
                Text {
                    text: "Safe to share — anyone can seal a note to this key, but never decrypt one. Scan it into the graffito Mac app to mirror the same key there.";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 176px;
                        height: 176px;
                        Image {
                            source: DeviceQuantumKey.public-qr;
                            width: 176px;
                            height: 176px;
                            image-rendering: pixelated;
                        }
                        TouchArea {
                            clicked => {
                                DeviceQuantumKey.qr-zoom = true;
                                Callbacks.device-quantum-key-qr-zoom(true);
                            }
                        }
                    }
                }
                Text {
                    text: "Dense QR — tap to fill the screen, hold steady and well-lit.";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 12px;
                    wrap: word-wrap;
                }
                SecondaryAction {
                    width: 100%;
                    text: "Close";
                    clicked => { DeviceQuantumKey.view = ""; }
                }
            }

            // ---- Export private key: warning step ----
            if DeviceQuantumKey.has-key && DeviceQuantumKey.view == "private-warn": VerticalLayout {
                spacing: 12px;
                Text {
                    text: "Anyone who scans this can read every note sealed to this quantum key — treat it like a private key, because it is one. Use this only to back it up, or to mirror the same key onto the graffito Mac app.";
                    color: Theme.palette-foreground;
                    font-family: "Montserrat";
                    font-size: 14px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    SecondaryAction {
                        horizontal-stretch: 1;
                        text: "Cancel";
                        clicked => { DeviceQuantumKey.view = ""; }
                    }
                    PrimaryAction {
                        horizontal-stretch: 1;
                        text: "I understand — show it";
                        clicked => { Callbacks.device-quantum-key-reveal-private(); }
                    }
                }
            }

            // ---- Export private key: revealed ----
            if DeviceQuantumKey.has-key && DeviceQuantumKey.view == "private": VerticalLayout {
                spacing: 12px;
                if DeviceQuantumKey.private-fits-qr: HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 176px;
                        height: 176px;
                        Image {
                            source: DeviceQuantumKey.private-qr;
                            width: 176px;
                            height: 176px;
                            image-rendering: pixelated;
                        }
                        TouchArea {
                            clicked => {
                                DeviceQuantumKey.qr-zoom = true;
                                Callbacks.device-quantum-key-qr-zoom(true);
                            }
                        }
                    }
                }
                if !DeviceQuantumKey.private-fits-qr: Text {
                    text: "Too large for one QR — copy the text below instead.";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 12px;
                    wrap: word-wrap;
                }
                MonoCard {
                    text: DeviceQuantumKey.private-armor;
                    font-size: 12px;
                }
                SecondaryAction {
                    width: 100%;
                    text: "Close";
                    clicked => { Callbacks.device-quantum-key-hide-private(); }
                }
            }
        }
    }
}
