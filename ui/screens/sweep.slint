// Screen.sweep — extracted verbatim from app.slint on 2026-09-01
// (PLAN-graffito-arch.md phase 4a). The instantiation site in app.slint
// still sets width/height to the window; everything else is the
// original block body.
// ---------------------- screen 10: sweep / consolidate (compose-like)
// Shared flow: destination line (picker- or self-set), fee tiers with
// the collapse-on-Custom rate field, read-only inputs summary, live
// cost line. A sweep spends ALL coins by design — no coin picking.

import { Theme, UISize } from "@ui/theme.slint";
import { Screen, Callbacks, Ui, Sweep } from "../callbacks.slint";
import { PrimaryAction, ScreenHeader, PillOption, TierPills } from "../components.slint";

export component SweepScreen inherits VerticalLayout {
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 8px + UISize.control-center-status-bar-height;
    padding-bottom: 24px;
    spacing: 10px;

    ScreenHeader {
        vertical-stretch: 0;
        title: Sweep.kind == "consolidate" ? "Consolidate" : "Sweep";
        // Sweep: back to the destination picker (still in sweep
        // mode); consolidate: back to the coins list.
        back => {
            if Sweep.kind == "consolidate" {
                Callbacks.refresh-coins();
                Ui.screen = Screen.coins;
            } else {
                Callbacks.refresh-contacts();
                Ui.screen = Screen.contacts;
            }
        }
    }

    Text {
        vertical-stretch: 0;
        text: Sweep.dest-label;
        color: Theme.palette-muted;
        font-family: "SourceCodePro";
        font-size: 14px;
        overflow: elide;
    }

    TierPills {
        tier: Sweep.tier;
        pick(t) => { Sweep.tier = t; Callbacks.sweep-changed(); }
    }

    if Sweep.tier == 3: HorizontalLayout {
        vertical-stretch: 0;
        spacing: 8px;
        Rectangle {
            height: 44px;
            horizontal-stretch: 1;
            background: Theme.palette-surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: sweep-rate-input.has-focus ? Theme.palette-primary : Theme.palette-border;
            clip: true;
            sweep-rate-input := TextInput {
                x: 14px;
                width: parent.width - 28px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                text <=> Sweep.rate-text;
                color: Theme.palette-foreground;
                font-family: "SourceCodePro";
                font-size: 18px;
                single-line: true;
                edited => { Callbacks.sweep-changed(); }
                accepted => { self.clear-focus(); }
            }
        }
        Text {
            text: "sat/vB";
            color: Theme.palette-muted;
            font-family: "Montserrat";
            font-size: 16px;
            vertical-alignment: center;
        }
    }

    // Read-only inputs summary — a sweep always spends every coin.
    Rectangle {
        vertical-stretch: 0;
        border-radius: 12px;
        background: Theme.palette-surface;
        border-width: 1px;
        border-color: Theme.palette-border;
        height: 42px;
        Text {
            x: 14px;
            width: parent.width - 28px;
            height: parent.height;
            text: Sweep.inputs-line;
            color: Theme.palette-muted;
            font-family: "SourceCodePro";
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    Text {
        vertical-stretch: 0;
        text: Sweep.cost-line;
        color: Theme.palette-muted;
        font-family: "SourceCodePro";
        font-size: 14px;
        wrap: word-wrap;
    }

    PrimaryAction {
        vertical-stretch: 0;
        width: 100%;
        text: "Continue";
        disabled: !Sweep.can-continue;
        clicked => { Callbacks.sweep-continue(); }
    }

    Rectangle { vertical-stretch: 1; }
}
