// Screen.signed — extracted verbatim from app.slint on 2026-09-01
// (PLAN-graffito-arch.md phase 4a). The instantiation site in app.slint
// still sets width/height to the window; everything else is the
// original block body.
// -------------------------------------------- screen 8: signed PSBT

import { Theme, UISize } from "@ui/theme.slint";
import { Screen, Callbacks, Ui, SignPsbt } from "../callbacks.slint";
import { PrimaryAction, ScreenHeader } from "../components.slint";

export component SignedScreen inherits VerticalLayout {
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 16px + UISize.control-center-status-bar-height;
    padding-bottom: 24px;
    spacing: 14px;

    ScreenHeader {
        title: "Signed";
        back => { Ui.screen = SignPsbt.back-screen; }
    }
    Text {
        text: SignPsbt.summary;
        color: Theme.palette-foreground;
        font-family: "SourceCodePro";
        font-size: 15px;
        wrap: word-wrap;
    }
    if SignPsbt.has-qr: HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 264px;
            height: 264px;
            background: #FFFFFF;
            border-radius: 12px;
            Image {
                source: SignPsbt.qr;
                width: 240px;
                height: 240px;
                x: 12px;
                y: 12px;
            }
        }
    }
    Text {
        text: "Scan this with the companion or desktop app to broadcast. Also saved to /graffito/outbox.";
        color: Theme.palette-muted;
        font-family: "SourceCodePro";
        font-size: 13px;
        wrap: word-wrap;
    }
    Rectangle { vertical-stretch: 1; }
    PrimaryAction {
        width: 100%;
        text: "Done";
        clicked => { Callbacks.refresh-home(); Ui.screen = Screen.home; }
    }
}
