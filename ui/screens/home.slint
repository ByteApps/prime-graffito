// Screen.home — extracted verbatim from app.slint on 2026-09-01
// (PLAN-graffito-arch.md phase 4a). The instantiation site in app.slint
// still sets width/height to the window; everything else is the
// original block body.
// ------------------------------------------------ screen 0: home
// A NOTEBOOK's home (its address, notes, compose). The header back
// returns to the notebook list (screen 20 — the main screen).

import { Theme, UISize } from "@ui/theme.slint";
import { Screen, Callbacks, Ui, Home, Compose, Notes, Sync, Settings, Contacts, NotebooksUi, NotebookCb } from "../callbacks.slint";
import { PrimaryAction, SecondaryAction, ScreenHeader } from "../components.slint";

export component HomeScreen inherits VerticalLayout {
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 16px + UISize.control-center-status-bar-height;
    padding-bottom: 24px;
    spacing: 14px;

    ScreenHeader {
        title: NotebooksUi.title;
        back => { Callbacks.refresh-home(); NotebookCb.back-to-list(); }
    }

    if Home.address == "": Text {
        text: Ui.error == "" ? "Deriving identity…" : Ui.error;
        color: Theme.palette-muted;
        font-family: "Montserrat";
        font-size: 17px;
        wrap: word-wrap;
        horizontal-alignment: center;
    }

    if Home.address != "": VerticalLayout {
        spacing: 10px;
        Image {
            source: Home.qr;
            width: 190px;
            height: 190px;
            image-rendering: pixelated;
            x: (parent.width - self.width) / 2;
        }
        Text {
            text: Home.address;
            color: Theme.palette-muted;
            font-family: "SourceCodePro";
            font-size: 13px;
            wrap: char-wrap;
            horizontal-alignment: center;
        }
        Text {
            text: Home.balance-line;
            color: Theme.palette-foreground;
            font-family: "Montserrat";
            font-size: 20px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: Home.sync-line + " · " + Home.network;
            color: Theme.palette-muted;
            font-family: "SourceCodePro";
            font-size: 14px;
            horizontal-alignment: center;
        }
    }

    Rectangle { vertical-stretch: 1; }

    PrimaryAction {
        width: 100%;
        text: "Compose note";
        disabled: Home.address == "";
        clicked => {
            Contacts.pick-mode = "compose";
            Callbacks.refresh-contacts();
            Ui.screen = Screen.contacts;
        }
    }
    SecondaryAction {
        width: 100%;
        text: "Notes";
        clicked => {
            Callbacks.refresh-notes();
            Ui.screen = Screen.notes;
        }
    }
    SecondaryAction {
        width: 100%;
        text: "Sync";
        clicked => { Ui.screen = Screen.sync; }
    }
    // No Settings here — it is wallet-level (network, chunk, wallet
    // coins/sweep), reachable from the notebook list.
}
