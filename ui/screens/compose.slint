// Screen.compose — extracted verbatim from app.slint on 2026-09-01
// (PLAN-graffito-arch.md phase 4a). The instantiation site in app.slint
// still sets width/height to the window; everything else is the
// original block body.
// ---------------------------------------------- screen 3: compose
// Everything interactive stays in the top ~400px so the on-screen
// keyboard never covers a control (sibling-app gotcha).

import { Theme, UISize } from "@ui/theme.slint";
import { Screen, Callbacks, Ui, Compose } from "../callbacks.slint";
import { PrimaryAction, SecondaryAction, ScreenHeader, PillOption, EditorField, ToRowEntry } from "../components.slint";

export component ComposeScreen inherits VerticalLayout {
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 8px + UISize.control-center-status-bar-height;
    padding-bottom: 24px;
    spacing: 10px;

    ScreenHeader {
        vertical-stretch: 0;
        title: "Compose";
        // Back to the picker so the recipient can be changed
        // without losing the draft (Compose.text persists).
        back => { Callbacks.refresh-contacts(); Ui.screen = Screen.contacts; }
    }

    // Who this note goes to — set by the contacts picker; compose
    // itself has no address editing.
    Text {
        vertical-stretch: 0;
        text: Compose.to-label;
        color: Theme.palette-muted;
        font-family: "SourceCodePro";
        font-size: 14px;
        overflow: elide;
    }

    // Extra recipients (multi-recipient directed note): one row per
    // Compose.to-extra entry, each removable.
    for row in Compose.to-extra: ToRowEntry {
        vertical-stretch: 0;
        entry: row;
        remove => { Callbacks.remove-recipient(row.address); }
    }

    // "+ Add recipient" — only for an in-progress directed draft,
    // and only while under the 255-recipient cap.
    if Compose.to-address != "" && 1 + Compose.to-extra.length < 255: Rectangle {
        vertical-stretch: 0;
        height: 30px;
        TouchArea { clicked => { Callbacks.add-recipient-open(); } }
        HorizontalLayout {
            Text {
                text: "+ Add recipient";
                color: Theme.palette-primary;
                font-family: "Montserrat";
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: "›";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }

    // Pay-from (funding-unification): who funds this note —
    // notebook, spending wallet, or a mix. Compact nav row, like
    // the gift panel's header, opening the picker (screen 25).
    Rectangle {
        vertical-stretch: 0;
        height: 34px;
        TouchArea { clicked => { Callbacks.funding-open(); Ui.screen = Screen.pay-from; } }
        HorizontalLayout {
            Text {
                text: "Pay from · " + Compose.pay-from-label;
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: Compose.pay-from-balance + "  ›";
                color: Theme.palette-muted;
                font-family: "SourceCodePro";
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
    // Change destination (screen 26).
    Rectangle {
        vertical-stretch: 0;
        height: 30px;
        TouchArea { clicked => { Callbacks.change-open(); Ui.screen = Screen.change; } }
        HorizontalLayout {
            Text {
                text: "Change · " + Compose.change-label;
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: "›";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }

    HorizontalLayout {
        vertical-stretch: 0;
        spacing: 8px;
        PillOption {
            label: "Private";
            selected: Compose.private-note;
            horizontal-stretch: 1;
            tapped => { Compose.private-note = true; Callbacks.compose-changed(); }
        }
        PillOption {
            label: "Public";
            selected: !Compose.private-note;
            horizontal-stretch: 1;
            tapped => { Compose.private-note = false; Callbacks.compose-changed(); }
        }
    }

    HorizontalLayout {
        vertical-stretch: 0;
        spacing: 6px;
        PillOption {
            label: "Economy";
            selected: Compose.tier == 0;
            horizontal-stretch: 1;
            tapped => { Compose.tier = 0; Callbacks.compose-changed(); }
        }
        PillOption {
            label: "Normal";
            selected: Compose.tier == 1;
            horizontal-stretch: 1;
            tapped => { Compose.tier = 1; Callbacks.compose-changed(); }
        }
        PillOption {
            label: "Fast";
            selected: Compose.tier == 2;
            horizontal-stretch: 1;
            tapped => { Compose.tier = 2; Callbacks.compose-changed(); }
        }
        PillOption {
            label: "Custom";
            selected: Compose.tier == 3;
            horizontal-stretch: 1;
            tapped => { Compose.tier = 3; Callbacks.compose-changed(); }
        }
    }

    // Custom fee-rate field — revealed ONLY when the Custom tier is
    // selected (tapping the pill above is the toggle). The three
    // preset tiers need no field, so it stays out of the way.
    if Compose.tier == 3: HorizontalLayout {
        vertical-stretch: 0;
        spacing: 8px;
        Rectangle {
            height: 44px;
            horizontal-stretch: 1;
            background: Theme.palette-surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: rate-input.has-focus ? Theme.palette-primary : Theme.palette-border;
            clip: true;
            rate-input := TextInput {
                x: 14px;
                width: parent.width - 28px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                text <=> Compose.rate-text;
                color: Theme.palette-foreground;
                font-family: "SourceCodePro";
                font-size: 18px;
                single-line: true;
                edited => { Callbacks.compose-changed(); }
                accepted => { self.clear-focus(); }
            }
        }
        Text {
            text: "sat/vB";
            color: Theme.palette-muted;
            font-family: "Montserrat";
            font-size: 16px;
            vertical-alignment: center;
        }
    }

    // Gift amount — directed notes only. Collapsible panel (styled
    // like the compose panels): the recipient output carries this
    // many sats instead of the default dust. Default/min = 330.
    if Compose.to-address != "": Rectangle {
        vertical-stretch: 0;
        border-radius: 12px;
        background: Theme.palette-surface;
        border-width: 1px;
        border-color: Theme.palette-border;
        height: gift-col.preferred-height;
        gift-col := VerticalLayout {
            padding: 10px;
            spacing: 8px;
            Rectangle {
                height: 22px;
                TouchArea { clicked => { Compose.gift-expanded = !Compose.gift-expanded; } }
                HorizontalLayout {
                    Text {
                        text: "Gift · \{Compose.gift-sats} sats";
                        color: Theme.palette-muted;
                        font-family: "SourceCodePro";
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    Rectangle { }
                    Image {
                        source: Compose.gift-expanded
                            ? @image-url("../../resources/icons/chevron-up.svg")
                            : @image-url("../../resources/icons/chevron-down.svg");
                        colorize: Theme.palette-muted;
                        width: 16px;
                        height: 16px;
                        y: (parent.height - 16px) / 2;
                    }
                }
            }
            if Compose.gift-expanded: Text {
                text: "Sats sent to the recipient with your note. Minimum 330 (dust).";
                color: Theme.palette-muted;
                font-family: "SourceCodePro";
                font-size: 12px;
                wrap: word-wrap;
            }
            if Compose.gift-expanded: Rectangle {
                height: 44px;
                background: Theme.palette-background;
                border-radius: 12px;
                border-width: 1px;
                border-color: gift-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                clip: true;
                gift-input := TextInput {
                    x: 14px;
                    width: parent.width - 28px;
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                    text <=> Compose.gift-sats;
                    color: Theme.palette-foreground;
                    font-family: "SourceCodePro";
                    font-size: 18px;
                    single-line: true;
                    input-type: number;
                    edited => { Callbacks.compose-changed(); }
                    accepted => { self.clear-focus(); }
                }
            }
        }
    }

    // Post-quantum Security section — a directed private single-
    // recipient note, OR a private self-note (no recipient —
    // PLAN-graffito-self-pw.md; notebook-funded only, same as the
    // directed case). Passphrase (Argon2id) is available either
    // way; ML-KEM stays directed-only (Compose.pq-mlkem-eligible),
    // since a self-note's KEM receive key would derive from the
    // same leaf as its enc key.
    if Compose.pq-eligible: Rectangle {
        vertical-stretch: 0;
        border-radius: 12px;
        background: Theme.palette-surface;
        border-width: 1px;
        border-color: Theme.palette-border;
        height: security-col.preferred-height;
        security-col := VerticalLayout {
            padding: 10px;
            spacing: 8px;
            Text {
                text: "Quantum-safe security";
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 14px;
                font-weight: 600;
            }
            HorizontalLayout {
                spacing: 8px;
                PillOption {
                    label: "Passphrase";
                    selected: Compose.pq-passphrase-active;
                    horizontal-stretch: 1;
                    tapped => {
                        Compose.pq-passphrase-active = !Compose.pq-passphrase-active;
                        Callbacks.compose-changed();
                    }
                }
                if Compose.pq-mlkem-eligible: PillOption {
                    label: "ML-KEM";
                    selected: Compose.pq-mlkem-active;
                    horizontal-stretch: 1;
                    opacity: Compose.pq-mlkem-available ? 1.0 : 0.4;
                    tapped => {
                        Compose.pq-mlkem-active = !Compose.pq-mlkem-active;
                        Callbacks.compose-changed();
                    }
                }
            }
            if Compose.pq-passphrase-active: HorizontalLayout {
                height: 44px;
                spacing: 8px;
                Rectangle {
                    height: 44px;
                    horizontal-stretch: 1;
                    background: Theme.palette-background;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: pq-pass-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                    clip: true;
                    pq-pass-input := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        height: 24px;
                        y: (parent.height - self.height) / 2;
                        text <=> Compose.pq-passphrase-text;
                        color: Theme.palette-foreground;
                        font-family: "SourceCodePro";
                        font-size: 15px;
                        single-line: true;
                        edited => { Callbacks.pq-passphrase-changed(); }
                        accepted => { self.clear-focus(); }
                    }
                }
                SecondaryAction {
                    // Sibling SecondaryActions all use width: 100%
                    // (they're the sole control in their row); this
                    // one shares a row with the passphrase field, so
                    // it needs an explicit width AND a font-size/
                    // padding that actually fit "Generate" — the
                    // previous 90px at the component's default 20px
                    // font + 20px horizontal padding left no room
                    // for the label (elided down to nothing, a
                    // narrow empty pill).
                    width: 108px;
                    font-size: 15px;
                    padding-horizontal: 12px;
                    text: "Generate";
                    clicked => { Callbacks.pq-generate-passphrase(); }
                }
            }
            if Compose.pq-passphrase-active: Text {
                text: Compose.pq-passphrase-strength;
                color: Compose.pq-passphrase-weak ? Theme.palette-danger : Theme.palette-muted;
                font-family: "SourceCodePro";
                font-size: 12px;
                wrap: word-wrap;
            }
            if Compose.pq-mlkem-eligible && (Compose.pq-mlkem-active || !Compose.pq-mlkem-available): Text {
                text: Compose.pq-mlkem-caption;
                color: Theme.palette-muted;
                font-family: "SourceCodePro";
                font-size: 12px;
                wrap: word-wrap;
            }
            if Compose.pq-security-label != "": Text {
                text: Compose.pq-security-label;
                color: Theme.palette-primary;
                font-family: "SourceCodePro";
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }

    editor := EditorField {
        vertical-stretch: 0;
        // The To row moved to the contacts picker; only a small
        // to-label remains above, so the editor gets its height
        // back while Continue stays above the on-screen keyboard.
        height: 118px;
        text <=> Compose.text;
        placeholder: "Type your note…";
        changed => { Callbacks.compose-changed(); }
        // Keyboard Done: the system keyboard's Done key sends a
        // plain '\n'; Rust strips it and bumps dismiss-nonce —
        // dropping focus here hides the keyboard (IMR Disable).
        property <int> dn: Compose.dismiss-nonce;
        changed dn => { self.clear-focus(); }
    }

    // Live cost readout — updates every keystroke.
    Text {
        vertical-stretch: 0;
        text: Compose.cost-line;
        color: Theme.palette-muted;
        font-family: "SourceCodePro";
        font-size: 14px;
        wrap: word-wrap;
    }

    PrimaryAction {
        vertical-stretch: 0;
        width: 100%;
        text: "Continue";
        disabled: !Compose.can-continue;
        clicked => {
            editor.clear-focus();
            Callbacks.compose-continue();
        }
    }

    Rectangle { vertical-stretch: 1; }
}
