// Screen.note — extracted verbatim from app.slint on 2026-09-01
// (PLAN-graffito-arch.md phase 4a). The instantiation site in app.slint
// still sets width/height to the window; everything else is the
// original block body.
// -------------------------------------------- screen 2: note view

import { Theme, UISize } from "@ui/theme.slint";
import { Screen, Callbacks, Ui, View } from "../callbacks.slint";
import { SecondaryAction, ScreenHeader, PillOption } from "../components.slint";

export component NoteScreen inherits VerticalLayout {
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 16px + UISize.control-center-status-bar-height;
    padding-bottom: 24px;
    spacing: 12px;

    ScreenHeader {
        title: "Note";
        back => { Callbacks.refresh-notes(); Ui.screen = Screen.notes; }
    }

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: View.badge;
            color: View.badge == "PRIVATE" ? Theme.palette-primary : Theme.palette-muted;
            font-family: "Montserrat";
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if View.has-qr: PillOption {
            width: 130px;
            label: View.show-qr ? "Show text" : "Show tx QR";
            selected: View.show-qr;
            tapped => { View.show-qr = !View.show-qr; }
        }
    }

    Rectangle {
        vertical-stretch: 1;
        background: Theme.palette-surface;
        border-radius: 16px;
        clip: true;
        if !View.show-qr: Flickable {
            x: 14px; y: 14px;
            width: parent.width - 28px;
            height: parent.height - 28px;
            viewport-width: self.width;
            viewport-height: max(self.height, body.preferred-height);
            body := Text {
                width: parent.width;
                text: View.text;
                color: Theme.palette-foreground;
                font-family: "SourceCodePro";
                font-size: 18px;
                wrap: word-wrap;
            }
        }
        if View.show-qr: VerticalLayout {
            padding: 14px;
            spacing: 8px;
            // Plain Rectangle parent: layouts ignore a child's x/y,
            // so centering math must live one level down.
            Rectangle {
                vertical-stretch: 1;
                Image {
                    source: View.qr;
                    width: min(parent.width, parent.height, 360px);
                    height: self.width;
                    image-rendering: pixelated;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
            Text {
                text: "Scan with the companion's “Scan from device” to broadcast.";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
    }

    Text {
        text: View.meta;
        color: Theme.palette-muted;
        font-family: "SourceCodePro";
        font-size: 13px;
        wrap: char-wrap;
    }

    // Post-quantum lock state (pq.rs). Exactly one of the three
    // blocks below shows: an explanatory caption (no manual unlock
    // possible), a password field + Unlock (FLAG_PW), or neither
    // when the note isn't locked.
    if View.locked && View.lock-caption != "": Text {
        vertical-stretch: 0;
        text: View.lock-caption;
        color: Theme.palette-muted;
        font-family: "Montserrat";
        font-size: 13px;
        wrap: word-wrap;
    }
    if View.locked && View.needs-password: VerticalLayout {
        vertical-stretch: 0;
        spacing: 6px;
        Text {
            text: "This note needs a password to unlock.";
            color: Theme.palette-muted;
            font-family: "Montserrat";
            font-size: 13px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            height: 44px;
            spacing: 8px;
            Rectangle {
                height: 44px;
                horizontal-stretch: 1;
                background: Theme.palette-surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: unlock-input.has-focus ? Theme.palette-primary : Theme.palette-border;
                clip: true;
                unlock-input := TextInput {
                    x: 14px;
                    width: parent.width - 28px;
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                    text <=> View.unlock-password;
                    color: Theme.palette-foreground;
                    font-family: "SourceCodePro";
                    font-size: 16px;
                    single-line: true;
                    input-type: password;
                    accepted => { self.clear-focus(); Callbacks.unlock-note(View.unlock-password); }
                }
            }
            PillOption {
                width: 90px;
                label: "Unlock";
                selected: true;
                tapped => {
                    unlock-input.clear-focus();
                    Callbacks.unlock-note(View.unlock-password);
                }
            }
        }
        if View.unlock-error != "": Text {
            text: View.unlock-error;
            color: Theme.palette-danger;
            font-family: "Montserrat";
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    if View.reply-address != "" || View.reply-set.length > 1: HorizontalLayout {
        vertical-stretch: 0;
        spacing: 8px;
        if View.reply-address != "": SecondaryAction {
            text: "Reply";
            clicked => { Callbacks.reply-to-note(); }
        }
        if View.reply-set.length > 1: SecondaryAction {
            text: "Reply all";
            clicked => { Callbacks.reply-all-to-note(); }
        }
    }
}
