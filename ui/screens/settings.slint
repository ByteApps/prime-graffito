// Screen.settings — extracted verbatim from app.slint on 2026-09-01
// (PLAN-graffito-arch.md phase 4a). The instantiation site in app.slint
// still sets width/height to the window; everything else is the
// original block body.
// -------------------------------------------- screen 6: settings

import { Theme, UISize } from "@ui/theme.slint";
import { Screen, Callbacks, Ui, Home, Settings, Contacts, Coins, Sweep, Recovery } from "../callbacks.slint";
import { SecondaryAction, ScreenHeader, PillOption } from "../components.slint";

export component SettingsScreen inherits VerticalLayout {
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 16px + UISize.control-center-status-bar-height;
    padding-bottom: 0;
    spacing: 14px;

    ScreenHeader {
        title: "Settings";
        back => { Ui.screen = Screen.notebooks; }
    }

    // Settings has grown (Coins/Sweep, chunk, Accounts, the whole
    // Dangerous area) — scroll the body, keep the header fixed.
    Flickable {
        vertical-stretch: 1;
        viewport-width: self.width;
        viewport-height: s6-content.preferred-height;
        s6-content := VerticalLayout {
            spacing: 14px;
            padding-bottom: 24px;

            SecondaryAction {
                width: 100%;
                text: "Network: " + Home.network;
                clicked => { Callbacks.cycle-network(); }
            }

    // Funds — viewer-first Coins (consolidate lives there) and the
    // sweep flow (destination picked first, compose-like screen).
    HorizontalLayout {
        spacing: 8px;
        SecondaryAction {
            horizontal-stretch: 1;
            text: "Coins";
            clicked => {
                Callbacks.refresh-coins();
                Ui.screen = Screen.coins;
            }
        }
        SecondaryAction {
            horizontal-stretch: 1;
            text: "Sweep funds…";
            disabled: Home.address == "";
            clicked => {
                Contacts.pick-mode = "sweep";
                Callbacks.refresh-contacts();
                Ui.screen = Screen.contacts;
            }
        }
    }

    Text {
        text: Settings.chunk-error == "" ? "OP_RETURN chunk size" : Settings.chunk-error;
        color: Settings.chunk-error == "" ? Theme.palette-muted : Theme.palette-danger;
        font-family: "Montserrat";
        font-size: 14px;
    }
    HorizontalLayout {
        spacing: 6px;
        PillOption {
            label: "Standard";
            selected: Settings.chunk-mode == 0;
            horizontal-stretch: 1;
            tapped => { Settings.chunk-mode = 0; Callbacks.chunk-changed(); }
        }
        PillOption {
            label: "80 compat";
            selected: Settings.chunk-mode == 1;
            horizontal-stretch: 1;
            tapped => { Settings.chunk-mode = 1; Callbacks.chunk-changed(); }
        }
        PillOption {
            label: "Custom";
            selected: Settings.chunk-mode == 2;
            horizontal-stretch: 1;
            tapped => { Settings.chunk-mode = 2; Callbacks.chunk-changed(); }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            height: 44px;
            horizontal-stretch: 1;
            background: Theme.palette-surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: chunk-input.has-focus ? Theme.palette-primary : Theme.palette-border;
            clip: true;
            chunk-input := TextInput {
                x: 14px;
                width: parent.width - 28px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                text <=> Settings.chunk-text;
                color: Theme.palette-foreground;
                font-family: "SourceCodePro";
                font-size: 18px;
                single-line: true;
                edited => {
                    Settings.chunk-mode = 2;
                    Callbacks.chunk-changed();
                }
                accepted => { self.clear-focus(); }
            }
        }
        Text {
            text: "bytes";
            color: Theme.palette-muted;
            font-family: "Montserrat";
            font-size: 16px;
            vertical-alignment: center;
        }
    }


    Text {
        text: "Chunk size caps each OP_RETURN output. Standard (100000) matches Bitcoin Core v30 relay defaults, verified on mempool.space; pick 80 if your broadcast endpoint rejects a note, then recompose it.";
        color: Theme.palette-muted;
        font-family: "Montserrat";
        font-size: 13px;
        wrap: word-wrap;
    }

    Text {
        text: Settings.locktime-error == "" ? Settings.locktime-effective : Settings.locktime-error;
        color: Settings.locktime-error == "" ? Theme.palette-muted : Theme.palette-danger;
        font-family: "Montserrat";
        font-size: 14px;
    }
    HorizontalLayout {
        spacing: 6px;
        PillOption {
            label: "Chain height";
            selected: Settings.locktime-mode == 0;
            horizontal-stretch: 1;
            tapped => { Settings.locktime-mode = 0; Callbacks.locktime-changed(); }
        }
        PillOption {
            label: "Zero";
            selected: Settings.locktime-mode == 1;
            horizontal-stretch: 1;
            tapped => { Settings.locktime-mode = 1; Callbacks.locktime-changed(); }
        }
        PillOption {
            label: "Custom";
            selected: Settings.locktime-mode == 2;
            horizontal-stretch: 1;
            tapped => { Settings.locktime-mode = 2; Callbacks.locktime-changed(); }
        }
    }
    // The height field is only meaningful for Custom — same
    // collapse-on-Custom rule the compose screen's rate field uses.
    if Settings.locktime-mode == 2: HorizontalLayout {
        spacing: 8px;
        Rectangle {
            height: 44px;
            horizontal-stretch: 1;
            background: Theme.palette-surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: locktime-input.has-focus ? Theme.palette-primary : Theme.palette-border;
            clip: true;
            locktime-input := TextInput {
                x: 14px;
                width: parent.width - 28px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                text <=> Settings.locktime-text;
                color: Theme.palette-foreground;
                font-family: "SourceCodePro";
                font-size: 18px;
                single-line: true;
                edited => {
                    Settings.locktime-mode = 2;
                    Callbacks.locktime-changed();
                }
                accepted => { self.clear-focus(); }
            }
        }
        Text {
            text: "height";
            color: Theme.palette-muted;
            font-family: "Montserrat";
            font-size: 16px;
            vertical-alignment: center;
        }
    }

    // The wallet-context switcher (accounts) is a normal setting.
    SecondaryAction {
        width: 100%;
        text: "Accounts…";
        clicked => { Ui.screen = Screen.accounts; }
    }

    // Post-quantum (pq.rs): this notebook's ML-KEM receive
    // identity — level picker, fingerprint, public-key QR to hand
    // to a contact. Public-key export only.
    SecondaryAction {
        width: 100%;
        text: "Quantum keys…";
        clicked => { Callbacks.open-quantum-keys(); Ui.screen = Screen.quantum-keys; }
    }

    // Personal device quantum key (PLAN-graffito-quantum-key.md):
    // a single NON-seed-derived ML-KEM keypair — generate/import,
    // export, replace, delete. Distinct from "Quantum keys…"
    // above (those are per-notebook and seed-derived); this one
    // is what a private SELF-note's ML-KEM pill seals against.
    SecondaryAction {
        width: 100%;
        text: "Quantum key…";
        clicked => { Callbacks.open-device-quantum-key(); Ui.screen = Screen.device-quantum-key; }
    }

    // Spending wallet (funding-unification): an optional BIP-84
    // native-segwit wallet (same seed) that holds funds instead of
    // the notebook, scoped to the active (network, seed, account).
    Rectangle {
        height: 1px;
        background: Theme.palette-border;
    }
    Text {
        text: "Separate spending wallet";
        color: Theme.palette-foreground;
        font-family: "Montserrat";
        font-size: 15px;
        font-weight: 600;
    }
    Text {
        text: "Fresh bc1q addresses hold your funds instead of the notebook — protects your balance and pubkey behind fresh-address hygiene. Costs a little more per note, and a shared spending pool publicly links the notes it pays for.";
        color: Theme.palette-muted;
        font-family: "Montserrat";
        font-size: 13px;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 8px;
        PillOption {
            label: "Off";
            selected: !Settings.spending-enabled;
            horizontal-stretch: 1;
            tapped => { Callbacks.set-spending-enabled(false); }
        }
        PillOption {
            label: "On";
            selected: Settings.spending-enabled;
            horizontal-stretch: 1;
            tapped => { Callbacks.set-spending-enabled(true); }
        }
    }
    if Settings.spending-enabled: VerticalLayout {
        spacing: 10px;
        Image {
            source: Settings.spending-qr;
            width: 150px;
            height: 150px;
            image-rendering: pixelated;
            x: (parent.width - self.width) / 2;
        }
        Text {
            text: Settings.spending-address;
            color: Theme.palette-muted;
            font-family: "SourceCodePro";
            font-size: 12px;
            wrap: char-wrap;
            horizontal-alignment: center;
        }
        Text {
            text: Settings.spending-balance-line;
            color: Theme.palette-foreground;
            font-family: "Montserrat";
            font-size: 17px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: "Next receive address, above. Paste every address below into the companion's \"Spending wallet addresses\" field so it can find this wallet's coins on the next sync — the companion otherwise only scans the notebook.";
            color: Theme.palette-muted;
            font-family: "Montserrat";
            font-size: 12px;
            wrap: word-wrap;
        }
        Rectangle {
            height: 76px;
            background: Theme.palette-surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.palette-border;
            clip: true;
            Flickable {
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
                height: parent.height - 16px;
                viewport-height: max(self.height, addr-text.preferred-height);
                addr-text := Text {
                    width: parent.width;
                    text: Settings.spending-addresses-text == "" ? "No addresses used yet." : Settings.spending-addresses-text;
                    color: Theme.palette-muted;
                    font-family: "SourceCodePro";
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        // Companion watch window (funding-unification gap-discovery,
        // option (b), 2026-07-19): the next 20 receive + 20 change
        // addresses, exported so the companion can probe AHEAD of
        // what the device has revealed/spent — the piece that makes
        // a restore (or an external deposit to a not-yet-shown
        // address) still findable on the next sync.
        Rectangle {
            height: 1px;
            background: Theme.palette-border;
        }
        Text {
            text: "Companion watch window";
            color: Theme.palette-foreground;
            font-family: "Montserrat";
            font-size: 13px;
            font-weight: 600;
        }
        Text {
            text: "Next 20 receive + 20 change addresses this wallet could use next. Paste the whole block below into the companion's \"Spending wallet addresses\" field (or scan the QR) so it can find coins at addresses you haven't revealed or spent yet — this is what makes a restore converge.";
            color: Theme.palette-muted;
            font-family: "Montserrat";
            font-size: 12px;
            wrap: word-wrap;
        }
        Image {
            source: Settings.spending-window-qr;
            width: 150px;
            height: 150px;
            image-rendering: pixelated;
            x: (parent.width - self.width) / 2;
        }
        Rectangle {
            height: 76px;
            background: Theme.palette-surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.palette-border;
            clip: true;
            Flickable {
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
                height: parent.height - 16px;
                viewport-height: max(self.height, window-text.preferred-height);
                window-text := Text {
                    width: parent.width;
                    text: Settings.spending-window-text;
                    color: Theme.palette-muted;
                    font-family: "SourceCodePro";
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }
    }

    // ---- Dangerous area: reveal keys, grouped by risk ----
    // Recovery words + exports are all REVEALS; split by what a
    // captured value costs you — public (watch-only) vs private
    // (spends + decrypts). (Sal 2026-07-13.)
    Rectangle {
        height: 1px;
        background: Theme.palette-danger;
    }
    Text {
        text: "Dangerous area";
        color: Theme.palette-danger;
        font-family: "Montserrat";
        font-size: 13px;
        font-weight: 700;
    }
    Text {
        text: "These show secrets on screen. Reveal only somewhere private — no cameras, no one watching over your shoulder.";
        color: Theme.palette-muted;
        font-family: "Montserrat";
        font-size: 13px;
        wrap: word-wrap;
    }
    SecondaryAction {
        width: 100%;
        text: "Public keys…";
        disabled: !Recovery.seed-available;
        clicked => {
            Callbacks.reveal-public();
            Ui.screen = Screen.public-keys;
        }
    }
    Text {
        text: "Account xpub + descriptor. Watch-only — safe to share so someone can see this account's balance; can't spend or read private notes.";
        color: Theme.palette-muted;
        font-family: "Montserrat";
        font-size: 12px;
        wrap: word-wrap;
    }
    SecondaryAction {
        width: 100%;
        text: "Private keys…";
        disabled: !Recovery.seed-available;
        clicked => {
            Callbacks.reveal-private();
            Ui.screen = Screen.private-keys;
        }
    }
    Text {
        text: "Recovery words + a notebook's raw key (hex/WIF). Anyone who sees these controls the coins and can read every private note. Keep them off cameras and out of sight.";
        color: Theme.palette-danger;
        font-family: "Montserrat";
        font-size: 12px;
        wrap: word-wrap;
    }

        }
    }
}
