// AppWindow's shared building blocks (headers, actions, list rows),
// moved out of app.slint verbatim on 2026-09-01 (PLAN-graffito-arch.md
// phase 4a) so ui/screens/*.slint and app.slint import the same
// components. Layout-identical: same elements, new file.

import { Theme } from "@ui/theme.slint";
import { ToRow, Confirm, ConfirmRow, Notes, NoteRow, ContactRow, FundingCoinRow } from "callbacks.slint";
import { Button } from "@ui/button.slint";
export component PrimaryAction inherits Button {
    background: Theme.palette-primary;
    foreground: #ffffff;
    border-color: transparent;
    border-width: 0px;
    font-weight: 600;
    font-family: "Montserrat";
    button-opacity: self.disabled ? 0.5 : 1.0;
    touch-expansion: 4px;
    font-size: 20px;
    padding-horizontal: 20px;
    padding-vertical: 12px;
    border-radius: 24px;
}

export component SecondaryAction inherits Button {
    background: Theme.palette-surface;
    foreground: Theme.palette-foreground;
    border-color: Theme.palette-border;
    border-width: 1px;
    font-weight: 600;
    font-family: "Montserrat";
    touch-expansion: 4px;
    font-size: 20px;
    padding-horizontal: 20px;
    padding-vertical: 12px;
    border-radius: 24px;
}

// Plain-TouchArea back control — the SDK IconButton drops taps (sibling
// apps' NOTES), so headers use text buttons.
export component BackBtn inherits TouchArea {
    width: 90px;
    height: 40px;
    callback back();
    clicked => { root.back(); }
    Text {
        text: "‹ Back";
        color: Theme.palette-primary;
        font-family: "Montserrat";
        font-size: 20px;
        font-weight: 600;
        vertical-alignment: center;
    }
}

export component ScreenHeader inherits Rectangle {
    in property <string> title;
    in property <bool> show-back: true;
    callback back();
    height: 48px;
    if root.show-back: BackBtn {
        x: 0;
        y: 4px;
        back => { root.back(); }
    }
    Text {
        text: root.title;
        color: Theme.palette-foreground;
        font-family: "Montserrat";
        font-size: 22px;
        font-weight: 700;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// Two-state pill toggle (Private / Public, fee tiers).
export component PillOption inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback tapped();
    height: 44px;
    border-radius: 22px;
    background: selected ? Theme.palette-primary : Theme.palette-surface;
    border-width: 1px;
    border-color: selected ? Theme.palette-primary : Theme.palette-border;
    TouchArea { clicked => { root.tapped(); } }
    Text {
        text: root.label;
        color: root.selected ? #ffffff : Theme.palette-foreground;
        font-family: "Montserrat";
        font-size: 17px;
        font-weight: 600;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// Scrollable multiline editor: Flickable around a builtin TextInput with
// cursor-follow (text-editor pattern — the SDK TextArea can't scroll).
export component EditorField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    out property <bool> has-focus: input.has-focus;
    callback changed();
    forward-focus: input;

    property <length> pad: 14px;

    background: Theme.palette-surface;
    border-radius: 16px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.palette-primary : Theme.palette-border;
    clip: true;

    fly := Flickable {
        x: root.pad;
        y: root.pad;
        width: parent.width - 2 * root.pad;
        height: parent.height - 2 * root.pad;
        viewport-width: self.width;
        viewport-height: max(self.height, input.preferred-height);

        input := TextInput {
            width: parent.width;
            text <=> root.text;
            color: Theme.palette-foreground;
            font-family: "SourceCodePro";
            font-size: 18px;
            single-line: false;
            wrap: word-wrap;
            vertical-alignment: top;
            page-height: fly.height;
            edited => { root.changed(); }
            cursor-position-changed(cpos) => {
                if (cpos.y + fly.viewport-y < 12px) {
                    fly.viewport-y = min(0px, max(fly.height - self.height, -cpos.y + 12px));
                } else if (cpos.y + fly.viewport-y > fly.height - 36px) {
                    fly.viewport-y = min(0px, max(fly.height - self.height, fly.height - cpos.y - 36px));
                }
            }
        }
    }

    Text {
        x: root.pad;
        y: root.pad;
        width: parent.width - 2 * root.pad;
        text: root.text == "" && input.preedit-text == "" ? root.placeholder : "";
        color: Theme.palette-muted;
        font-family: "SourceCodePro";
        font-size: 18px;
        wrap: word-wrap;
    }
}

export component NoteEntry inherits Rectangle {
    in property <NoteRow> entry;
    callback tapped();
    height: 76px;
    border-radius: 12px;
    background: touch.has-hover ? Theme.palette-surface : transparent;
    border-width: 1px;
    border-color: Theme.palette-border;
    touch := TouchArea { clicked => { root.tapped(); } }
    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.entry.preview;
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 18px;
                font-weight: 600;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.entry.badge;
                color: root.entry.badge == "PRIVATE" ? Theme.palette-primary : Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }
            // Post-quantum (pq.rs): a locked note (still encrypted — a
            // received pq note this device couldn't auto-decrypt) shows a
            // muted lock glyph instead of the "PQ" pill, so the two states
            // stay visually distinct at a glance. Same "PQ" pill styling as
            // the contacts picker's quantum-key badge (ContactEntry below).
            if root.entry.locked: Image {
                source: @image-url("../resources/icons/lock.svg");
                colorize: Theme.palette-danger;
                width: 16px;
                height: 16px;
                y: (parent.height - 16px) / 2;
            }
            if !root.entry.locked && root.entry.pq: Rectangle {
                width: 30px;
                border-radius: 8px;
                background: Theme.palette-primary;
                Text {
                    text: "PQ";
                    color: #ffffff;
                    font-family: "Montserrat";
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }
        Text {
            text: root.entry.meta;
            color: Theme.palette-muted;
            font-family: "SourceCodePro";
            font-size: 14px;
            overflow: elide;
        }
    }
}

// One coin on the Pay-from screen: an ASCII [x]/[  ] checkbox row (device
// font tofus fancy glyphs — same convention as the Notes sender filter).
export component FundingCoinEntry inherits Rectangle {
    in property <FundingCoinRow> entry;
    callback tapped();
    height: 48px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.palette-border;
    TouchArea { clicked => { root.tapped(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 8px;
        Rectangle {
            width: 26px;
            Text {
                text: root.entry.selected ? "[x]" : "[  ]";
                color: root.entry.selected ? Theme.palette-primary : Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 15px;
                font-weight: 700;
                x: 0;
                y: (parent.height - self.height) / 2;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.entry.label;
                color: root.entry.selected ? Theme.palette-foreground : Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.entry.meta;
                color: Theme.palette-muted;
                font-family: "SourceCodePro";
                font-size: 12px;
                overflow: elide;
            }
        }
    }
}

// A single-select destination row on the Change screen: ASCII (x)/( )
// radio marker, matching FundingCoinEntry's checkbox convention.
export component ChangeOptionRow inherits Rectangle {
    in property <string> option-label;
    in property <string> sub;
    in property <bool> selected;
    callback tapped();
    height: sub == "" ? 44px : 66px;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.selected ? Theme.palette-primary : Theme.palette-border;
    TouchArea { clicked => { root.tapped(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 8px;
        Rectangle {
            width: 26px;
            Text {
                text: root.selected ? "(x)" : "(  )";
                color: root.selected ? Theme.palette-primary : Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 15px;
                font-weight: 700;
                x: 0;
                y: (parent.height - self.height) / 2;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            padding-top: 8px;
            padding-bottom: 8px;
            Text {
                text: root.option-label;
                color: root.selected ? Theme.palette-foreground : Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            if root.sub != "": Text {
                text: root.sub;
                color: Theme.palette-muted;
                font-family: "SourceCodePro";
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}

// Contact row for the send-to picker: main tap picks, the right "name"
// zone toggles rename mode (its later-declared TouchArea wins the zone).
export component ContactEntry inherits Rectangle {
    in property <ContactRow> entry;
    callback tapped();
    callback rename();
    height: 64px;
    border-radius: 12px;
    background: touch.has-hover ? Theme.palette-surface : transparent;
    border-width: 1px;
    border-color: Theme.palette-border;
    touch := TouchArea { clicked => { root.tapped(); } }
    HorizontalLayout {
        padding: 10px;
        spacing: 8px;
        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            Text {
                text: root.entry.label;
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 18px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.entry.meta;
                color: Theme.palette-muted;
                font-family: "SourceCodePro";
                font-size: 13px;
                overflow: elide;
            }
        }
        if root.entry.pq-caption != "": Rectangle {
            width: 30px;
            border-radius: 8px;
            background: Theme.palette-primary;
            Text {
                text: "PQ";
                color: #ffffff;
                font-family: "Montserrat";
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
        Rectangle {
            width: 58px;
            border-radius: 10px;
            background: rename-touch.has-hover ? Theme.palette-border : transparent;
            Text {
                text: "name";
                color: Theme.palette-primary;
                font-family: "Montserrat";
                font-size: 13px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
            rename-touch := TouchArea { clicked => { root.rename(); } }
        }
    }
}

// One extra recipient row on the compose screen (multi-recipient directed
// notes) — label + a "×" remove button, styled exactly like the notebook
// list's archive-× control.
export component ToRowEntry inherits Rectangle {
    in property <ToRow> entry;
    callback remove();
    height: 34px;
    HorizontalLayout {
        Text {
            // `entry.label` is Rust-formatted via `to_label_for`, which
            // already carries a "to: " prefix (matches the primary
            // to-label Text above) — no double prefix here.
            text: root.entry.label;
            color: Theme.palette-muted;
            font-family: "SourceCodePro";
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 40px;
            TouchArea { clicked => { root.remove(); } }
            Text {
                text: "×";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 22px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }
}

// One row on the universal Confirm & sign screen (4) — an input or output
// decoded from the actual tx bytes (`notes_core::confirm::SummaryRow`).
// Output rows with no address (the OP_RETURN note row) show the subtitle
// as the main line instead; an unrecognized-address output ("other") is
// flagged in the danger color, same convention as the rest of the app.
export component ConfirmRowEntry inherits Rectangle {
    in property <ConfirmRow> entry;
    border-radius: 10px;
    border-width: 1px;
    border-color: entry.kind == "other" ? Theme.palette-danger : Theme.palette-border;
    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: entry.title != "" ? entry.title : entry.subtitle;
                color: Theme.palette-foreground;
                font-family: "SourceCodePro";
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if entry.amount != "": Text {
                text: entry.amount + " sats";
                color: Theme.palette-foreground;
                font-family: "SourceCodePro";
                font-size: 14px;
                font-weight: 700;
            }
        }
        if entry.title != "": Text {
            text: entry.subtitle;
            color: entry.kind == "other" ? Theme.palette-danger : Theme.palette-muted;
            font-family: "SourceCodePro";
            font-size: 12px;
            overflow: elide;
            wrap: word-wrap;
        }
    }
}
